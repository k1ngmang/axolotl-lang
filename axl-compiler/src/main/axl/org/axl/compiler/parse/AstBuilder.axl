/* Turns an ANTLR parse tree without syntax errors into the AST. */

fn build(path: String, className: String, ctx: CompilationUnitContext) -> SourceFile {
    val packageDecl = ctx.packageDecl()
    val packagePos: Pos? = if (packageDecl == null) null else pos(packageDecl.start)
    val packageName: String? = if (packageDecl == null) null else packageDecl.qualifiedName().getText()
    val imports = ArrayList<Import>()
    for (imp in ctx.importDecl()) {
        imports.add(Import(pos(imp.start), importKind(imp), imp.qualifiedName().getText()))
    }
    val decls = ArrayList<Decl>()
    for (top in ctx.topLevel()) {
        val decl = buildTopLevel(top)
        if (decl != null) {
            decls.add(decl)
        }
    }
    return SourceFile(path, className, packagePos, packageName, imports, decls)
}

fn pos(token: Token) -> Pos = Pos(token.getLine(), token.getCharPositionInLine() + 1)

private fn importKind(imp: ImportDeclContext) -> Import.Kind {
    val kind = imp.kind
    if (kind == null) {
        return Import.Kind.TYPE
    }
    return if (kind.getType() == AxolotlLexer.FN) Import.Kind.FN else Import.Kind.VAL
}

private fn buildTopLevel(top: TopLevelContext) -> Decl? {
    val function = top.functionDecl()
    if (function != null) {
        return buildFunction(function)
    }
    val data = top.dataClassDecl()
    if (data != null) {
        return DataClass(pos(data.start), pos(data.identifier().start), data.PRIVATE() != null,
            nameOf(data.identifier()), buildFields(data.field()), buildTypes(data.type()), buildAnnotations(data.annotation()),
            buildTypeParams(data.typeParams()), data.functionDecl() |> map { f -> buildFunction(f) })
    }
    val enumeration = top.enumDecl()
    if (enumeration != null) {
        return buildEnum(enumeration)
    }
    val classDecl = top.classDecl()
    if (classDecl != null) {
        return buildClass(classDecl)
    }
    val iface = top.interfaceDecl()
    if (iface != null) {
        return Interface(pos(iface.start), pos(iface.identifier().start), iface.PRIVATE() != null,
            nameOf(iface.identifier()), iface.SEALED() != null, buildFields(iface.field()),
            iface.interfaceMethod() |> map { m -> buildSignature(m) }, buildTypes(iface.type()), buildAnnotations(iface.annotation()),
            buildTypeParams(iface.typeParams()))
    }
    val value = top.valDecl()
    if (value != null) {
        return Value(pos(value.start), pos(value.identifier().start), value.PRIVATE() != null,
            nameOf(value.identifier()), typeOrNull(value.type()), buildExpr(value.expression()), buildAnnotations(value.annotation()))
    }
    return null
}

private fn buildEnum(enumeration: EnumDeclContext) -> Decl.EnumDecl {
    val constants = enumeration.enumConstant() |> map { c -> nameOf(c.identifier()) }
    val arguments = enumeration.enumConstant() |> map { c -> buildArguments(c.arguments()) }
    return EnumDecl(pos(enumeration.start), pos(enumeration.identifier().start), enumeration.PRIVATE() != null,
        nameOf(enumeration.identifier()), constants, buildAnnotations(enumeration.annotation()), buildFields(enumeration.field()),
        arguments)
}

private fn buildClass(ctx: ClassDeclContext) -> Decl.ClassDecl {
    val parameters = ArrayList<Property>()
    for (p in ctx.classParam()) {
        parameters.add(Property(pos(p.start), pos(p.identifier().start), p.PRIVATE() != null, nameOf(p.identifier()),
            buildType(p.type()), null, p.VAR() != null, buildAnnotations(p.annotation())))
    }
    val properties = ArrayList<Property>()
    val methods = ArrayList<Decl.Function>()
    val constructors = ArrayList<Decl.Constructor>()
    for (member in ctx.classMember()) {
        if (member is ConstructorMemberContext) {
            constructors.add(buildConstructor(member))
        } else if (member is PropertyMemberContext) {
            properties.add(Property(pos(member.start), pos(member.identifier().start), member.PRIVATE() != null,
                nameOf(member.identifier()), typeOrNull(member.type()), buildExpr(member.expression()), member.VAR() != null,
                buildAnnotations(member.annotation())))
        } else if (member is MethodMemberContext) {
            methods.add(buildFunction(member.functionDecl()))
        } else {
            throw IllegalStateException("unknown member " + member.getClass())
        }
    }
    val superArgs: List<Expr>? = if (hasSuperArgs(ctx)) buildArguments(ctx.arguments()) else null
    val primary = ctx.primaryConstructor()
    return ClassDecl(pos(ctx.start), pos(ctx.identifier().start), ctx.PRIVATE() != null, nameOf(ctx.identifier()),
        parameters, properties, methods, buildTypes(ctx.type()), buildAnnotations(ctx.annotation()), buildTypeParams(ctx.typeParams()),
        superArgs, constructors, if (primary == null) null else pos(primary.IDENTIFIER().getSymbol()),
        primary != null && primary.PRIVATE() != null,
        if (primary == null) List.of() else buildAnnotations(primary.annotation()))
}

/** `constructor(a: String) = this(a, 0)`: only a call of `this`, which Java makes the first statement of the constructor. */
private fn buildConstructor(ctx: ConstructorMemberContext) -> Decl.Constructor {
    val value = ctx.functionBody().expression()
    if (value == null) {
        throw Rejected(pos(ctx.functionBody().start), "a constructor has no body: it passes its values on to the class's " +
            "parameters, as in `constructor(name: String) = this(name, 0)`")
    }
    val call = buildExpr(value)
    if (call !is Expr.Call || call.target() != null || !call.name().equals("this")) {
        throw Rejected(pos(value.start), "a constructor passes its values on to the class's parameters with `this(...)`, " +
            "as in `constructor(name: String) = this(name, 0)`")
    }
    return Decl.Constructor(pos(ctx.start), pos(ctx.IDENTIFIER().getSymbol()), ctx.PRIVATE() != null, buildParams(ctx.param()),
        call.args(), call.pos(), buildAnnotations(ctx.annotation()))
}

/** `: Thread(name)` or `: Thread()`: a `(` after the colon, as the class parameters' `(` comes before it. */
private fn hasSuperArgs(ctx: ClassDeclContext) -> Boolean {
    val colon = ctx.COLON()
    if (colon == null) {
        return false
    }
    return ctx.LPAREN() |> anyMatch { paren -> paren.getSymbol().getTokenIndex() > colon.getSymbol().getTokenIndex() }
}

private fn buildFields(contexts: List<FieldContext>) -> List<Expr.Param> =
    contexts |> map { f -> Param(pos(f.start), nameOf(f.identifier()), buildType(f.type()), buildAnnotations(f.annotation())) }

private fn buildTypes(contexts: List<TypeContext>) -> List<TypeRef> = contexts |> map { t -> buildType(t) }

private fn buildFunction(ctx: FunctionDeclContext) -> Decl.Function {
    val params = buildParams(ctx.param())
    val body = ctx.functionBody()
    val bodyExpr = body.expression()
    val bodyBlock = body.block()
    val exprBody: Expr? = if (bodyExpr == null) null else buildExpr(bodyExpr)
    val block: Stmt.Block? = if (bodyBlock == null) null else buildBlock(bodyBlock)
    return Function(pos(ctx.start), pos(ctx.identifier().start), ctx.PRIVATE() != null, nameOf(ctx.identifier()),
        params, typeOrNull(ctx.type()), exprBody, block, buildAnnotations(ctx.annotation()), buildTypeParams(ctx.typeParams()))
}

private fn buildTypeParams(ctx: TypeParamsContext?) -> List<Decl.TypeParam> {
    if (ctx == null) {
        return List.of()
    }
    return ctx.typeParam() |> map { p -> Decl.TypeParam(pos(p.start), nameOf(p.identifier()), typeOrNull(p.type())) }
}

/** A method of an interface: a function without a body. */
private fn buildSignature(ctx: InterfaceMethodContext) -> Decl.Function =
    Function(pos(ctx.start), pos(ctx.identifier().start), false, nameOf(ctx.identifier()), buildParams(ctx.param()),
        typeOrNull(ctx.type()), null, null, buildAnnotations(ctx.annotation()), buildTypeParams(ctx.typeParams()))

private fn buildParams(contexts: List<ParamContext>) -> List<Expr.Param> {
    val params = ArrayList<Expr.Param>()
    for (p in contexts) {
        params.add(Param(pos(p.start), nameOf(p.identifier()), buildType(p.type()), buildAnnotations(p.annotation())))
    }
    return params
}

private fn buildAnnotations(contexts: List<AnnotationContext>) -> List<Decl.Annotation> =
    contexts |> map { a -> Annotation(pos(a.start), a.qualifiedName().getText(), buildAnnotationArgs(a.annotationArg())) }

private fn buildAnnotationArgs(contexts: List<AnnotationArgContext>) -> List<Decl.AnnotationArg> =
    contexts |> map { arg -> annotationValue(if (arg.identifier() == null) null else nameOf(arg.identifier()), arg.annotationValue()) }

private fn annotationValue(name: String?, ctx: AnnotationValueContext) -> Decl.AnnotationArg {
    val expression = ctx.expression()
    if (expression != null) {
        return AnnotationArg(name, buildExpr(expression), List.of())
    }
    val elements: List<Decl.AnnotationArg> = ctx.annotationValue() |> map { v -> annotationValue(null, v) }
    return AnnotationArg(name, null, elements)
}

private fn buildBlock(ctx: BlockContext) -> Stmt.Block =
    Block(pos(ctx.start), buildStatements(ctx.statement()), pos(ctx.stop))

private fn buildStatements(contexts: List<StatementContext>) -> List<Stmt> {
    val result = ArrayList<Stmt>()
    for (ctx in contexts) {
        val stmt = buildStatement(ctx)
        if (stmt != null) {
            result.add(stmt)
        }
    }
    return result
}

private fn buildStatement(ctx: StatementContext) -> Stmt? = when (ctx) {
    is ValStatementContext -> buildVal(ctx)
    is VarStatementContext -> {
        val decl = ctx.varDecl()
        Local(pos(decl.start), pos(decl.identifier().start), nameOf(decl.identifier()), typeOrNull(decl.type()),
            buildExpr(decl.expression()), true)
    }
    is ReturnStatementContext -> buildReturn(ctx)
    is UseStatementContext -> buildUse(ctx)
    is BreakStatementContext -> Stmt.Jump(pos(ctx.start), true)
    is ContinueStatementContext -> Stmt.Jump(pos(ctx.start), false)
    is IfStatementAltContext -> buildIf(ctx.ifStatement())
    is WhileStatementContext -> While(pos(ctx.start), buildExpr(ctx.expression()), buildBlock(ctx.block()))
    is ForStatementContext -> For(pos(ctx.start), pos(ctx.identifier().start), nameOf(ctx.identifier()),
        buildExpr(ctx.expression()), buildBlock(ctx.block()))
    is AttemptExitStatementContext -> buildAttemptExit(ctx)
    is AssignStatementContext -> buildAssign(ctx)
    is ExpressionStatementContext -> ExprStmt(pos(ctx.start), buildExpr(ctx.expression()))
    is EmptyStatementContext -> null
    else -> throw IllegalStateException("unknown statement " + ctx.getClass())
}

private fn buildVal(ctx: ValStatementContext) -> Stmt.Local {
    val decl = ctx.valDecl()
    if (decl.PRIVATE() != null) {
        throw Rejected(pos(ctx.start), "`private` is only allowed on top-level declarations")
    }
    return Local(pos(decl.start), pos(decl.identifier().start), nameOf(decl.identifier()), typeOrNull(decl.type()),
        buildExpr(decl.expression()), false)
}

private fn buildUse(ctx: UseStatementContext) -> Stmt.Use {
    val param = ctx.handlerParam()
    val handler: Expr? = if (ctx.expression().size() > 1) buildExpr(ctx.expression(1)) else null
    return Stmt.Use(pos(ctx.start), pos(ctx.identifier().start), nameOf(ctx.identifier()), typeOrNull(ctx.type()),
        buildExpr(ctx.expression(0)), buildBlock(ctx.block()), handlerName(param), handlerNamePos(param), handlerType(param), handler)
}

/** `e` of `else e ->` and `else e: IOException ->`; null without a name. */
private fn handlerName(ctx: HandlerParamContext?) -> String? = if (ctx == null) null else nameOf(ctx.identifier())

private fn handlerNamePos(ctx: HandlerParamContext?) -> Pos? = if (ctx == null) null else pos(ctx.identifier().start)

private fn handlerType(ctx: HandlerParamContext?) -> TypeRef? = if (ctx == null) null else typeOrNull(ctx.type())

private fn buildReturn(ctx: ReturnStatementContext) -> Stmt.Return {
    val value = ctx.expression()
    val result: Expr? = if (value == null) null else buildExpr(value)
    return Return(pos(ctx.start), result)
}

private fn buildAttemptExit(ctx: AttemptExitStatementContext) -> Stmt.AttemptExit {
    val param = ctx.handlerParam()
    return Stmt.AttemptExit(pos(ctx.start), buildExpr(ctx.expression()), handlerName(param), handlerNamePos(param), handlerType(param),
        buildExit(ctx.attemptExit()))
}

private fn buildExit(ctx: AttemptExitContext) -> Stmt {
    if (ctx.RETURN() == null) {
        return Stmt.Jump(pos(ctx.start), ctx.BREAK() != null)
    }
    val value = ctx.expression()
    return Return(pos(ctx.start), if (value == null) null else buildExpr(value))
}

private fn buildAssign(ctx: AssignStatementContext) -> Stmt.Assign =
    assignment(pos(ctx.start), ctx.postfixExpression(), ctx.assignOp(), ctx.expression())

private fn assignment(start: Pos, targetCtx: PostfixExpressionContext, op: AssignOpContext, valueCtx: ExpressionContext) -> Stmt.Assign {
    val target = buildPostfix(targetCtx)
    val assignable = target is Expr.Name || target is Expr.Member
    if (!assignable) {
        throw Rejected(target.pos(), "only a variable or a field can be assigned")
    }
    if (hasSafeStep(target)) {
        throw Rejected(target.pos(), "cannot assign through `?.`; check for null first: `if (x != null) { x.f = v }`")
    }
    return Assign(start, target, op.getText(), buildExpr(valueCtx))
}

private fn buildIf(ctx: IfStatementContext) -> Stmt.If =
    If(pos(ctx.start), buildExpr(ctx.expression()), buildBlock(ctx.block(0)), elseBranch(ctx))

private fn elseBranch(ctx: IfStatementContext) -> Stmt? {
    val nested = ctx.ifStatement()
    if (nested != null) {
        return buildIf(nested)
    }
    if (ctx.block().size() > 1) {
        return buildBlock(ctx.block(1))
    }
    return null
}

private fn buildExpr(ctx: ExpressionContext) -> Expr {
    val source = buildDisjunction(ctx.disjunction())
    if (ctx.pipeStage().isEmpty()) {
        return source
    }
    val stages = ctx.pipeStage() |> map { stage -> buildStage(stage) }
    val pipe = Pipe(source.pos(), source, stages)
    val fallback = ctx.additive()
    return if (fallback == null) pipe else Elvis(pipe.pos(), pipe, buildAdditive(fallback))
}

private fn buildStage(stage: PipeStageContext) -> Expr.Stage {
    val lambdaCtx = stage.lambda()
    val lambda: Expr.Lambda? = if (lambdaCtx == null) null else buildLambda(lambdaCtx)
    return Stage(pos(stage.start), nameOf(stage.identifier()), buildArguments(stage.arguments()), lambda)
}

private fn buildDisjunction(ctx: DisjunctionContext) -> Expr {
    val operands = ctx.conjunction() |> map { c -> buildConjunction(c) }
    return leftFold(ctx, operands)
}

private fn buildConjunction(ctx: ConjunctionContext) -> Expr {
    val operands = ctx.equality() |> map { c -> buildEquality(c) }
    return leftFold(ctx, operands)
}

private fn buildEquality(ctx: EqualityContext) -> Expr {
    val operands = ctx.comparison() |> map { c -> buildComparison(c) }
    return leftFold(ctx, operands)
}

private fn buildComparison(ctx: ComparisonContext) -> Expr {
    val operands = ctx.isCheck() |> map { c -> buildIsCheck(c) }
    return leftFold(ctx, operands)
}

private fn buildIsCheck(ctx: IsCheckContext) -> Expr {
    val target = buildElvis(ctx.elvis())
    if (ctx.IS() == null) {
        return target
    }
    val type = ctx.qualifiedName()
    return Is(target.pos(), target, TypeRef(pos(type.start), type.getText(), List.of(), false), ctx.BANG() != null)
}

private fn buildElvis(ctx: ElvisContext) -> Expr {
    val operands = ctx.additive() |> map { a -> buildAdditive(a) }
    // Right-nested so that `a ?: b ?: c` evaluates c only when both a and b are null.
    var result = operands.getLast()
    var i = operands.size() - 2
    while (i >= 0) {
        result = Elvis(operands.get(i).pos(), operands.get(i), result)
        i -= 1
    }
    return result
}

private fn buildAdditive(ctx: AdditiveContext) -> Expr {
    val operands = ctx.multiplicative() |> map { m -> buildMultiplicative(m) }
    return leftFold(ctx, operands)
}

private fn buildMultiplicative(ctx: MultiplicativeContext) -> Expr {
    val operands = ctx.prefixExpression() |> map { p -> buildPrefix(p) }
    return leftFold(ctx, operands)
}

/** Operators are the terminal children between the operand subtrees. */
private fn leftFold(ctx: ParserRuleContext, operands: List<Expr>) -> Expr {
    val operators = ArrayList<String>()
    for (child in ctx.children) {
        if (child is TerminalNode) {
            operators.add(child.getText())
        }
    }
    var result = operands.getFirst()
    var i = 1
    while (i < operands.size()) {
        result = Binary(result.pos(), operators.get(i - 1), result, operands.get(i))
        i += 1
    }
    return result
}

private fn buildPrefix(ctx: PrefixExpressionContext) -> Expr = when (ctx) {
    is UnaryExpressionContext -> buildUnary(ctx)
    is TryExpressionContext -> Try(pos(ctx.start), buildPrefix(ctx.prefixExpression()))
    is ThrowExpressionContext -> Throw(pos(ctx.start), buildPrefix(ctx.prefixExpression()))
    is AttemptExpressionContext -> buildAttempt(ctx)
    is PostfixAltContext -> buildPostfix(ctx.postfixExpression())
    else -> throw IllegalStateException("unknown expression " + ctx.getClass())
}

private fn buildUnary(ctx: UnaryExpressionContext) -> Expr {
    if (ctx.BANGBANG() != null) {
        return Unary(pos(ctx.start), "!", Unary(pos(ctx.start), "!", buildPrefix(ctx.prefixExpression())))
    }
    return Unary(pos(ctx.start), ctx.start.getText(), buildPrefix(ctx.prefixExpression()))
}

private fn buildAttempt(ctx: AttemptExpressionContext) -> Expr {
    val param = ctx.handlerParam()
    return Attempt(pos(ctx.start), buildExpr(ctx.expression(0)), handlerName(param), handlerNamePos(param), handlerType(param),
        buildExpr(ctx.expression(1)))
}

private fn hasSafeStep(e: Expr) -> Boolean = when (e) {
    is Expr.Member -> e.safe() || hasSafeStep(e.target())
    is Expr.Call -> {
        val target = e.target()
        e.safe() || (target != null && hasSafeStep(target))
    }
    else -> false
}

private fn buildPostfix(ctx: PostfixExpressionContext) -> Expr {
    var current = buildPrimary(ctx.primary())
    val suffixes = ctx.postfixSuffix()
    var i = 0
    while (i < suffixes.size()) {
        val suffix = suffixes.get(i)
        if (suffix is MemberSuffixContext) {
            val call = callAfter(suffixes, i)
            val member = nameOf(suffix.identifier())
            val memberPos = pos(suffix.identifier().start)
            val safe = suffix.SAFE_DOT() != null
            if (call != null) {
                current = Call(memberPos, current, member, buildArguments(call.arguments()), safe)
                i += 1
            } else {
                current = Member(memberPos, current, member, safe)
            }
        } else if (suffix is CallSuffixContext) {
            current = namedCall(current, suffix)
        } else if (suffix is MethodRefSuffixContext) {
            current = MethodRef(pos(suffix.start), current, nameOf(suffix.identifier()))
        } else if (suffix is NotNullSuffixContext) {
            current = NotNull(pos(suffix.start), current)
        } else if (suffix is ClassSuffixContext) {
            current = ClassLiteral(pos(suffix.CLASS().getSymbol()), current)
        } else {
            throw IllegalStateException("unknown suffix " + suffix.getClass())
        }
        i += 1
    }
    return current
}

private fn callAfter(suffixes: List<PostfixSuffixContext>, index: Int) -> CallSuffixContext? {
    if (index + 1 >= suffixes.size()) {
        return null
    }
    val next = suffixes.get(index + 1)
    if (next is CallSuffixContext) {
        return next
    }
    return null
}

private fn namedCall(target: Expr, call: CallSuffixContext) -> Expr {
    if (target !is Expr.Name) {
        throw Rejected(pos(call.start), "only a named function can be called")
    }
    return Call(target.pos(), null, target.name(), buildArguments(call.arguments()), false)
}

private fn buildArguments(ctx: ArgumentsContext?) -> List<Expr> {
    if (ctx == null) {
        return List.of()
    }
    return ctx.expression() |> map { e -> buildExpr(e) }
}

private fn buildPrimary(ctx: PrimaryContext) -> Expr = when (ctx) {
    is LiteralPrimaryContext -> Literal(pos(ctx.start), ctx.getText())
    is NamePrimaryContext -> Name(pos(ctx.start), nameOf(ctx.identifier()))
    is ParenPrimaryContext -> Paren(pos(ctx.start), buildExpr(ctx.expression()))
    is LambdaPrimaryContext -> buildLambda(ctx.lambda())
    is WhenPrimaryContext -> buildWhen(ctx.whenExpression())
    is IfPrimaryContext -> buildConditional(ctx)
    is GenericConstructorContext -> buildGenericNew(ctx)
    else -> throw IllegalStateException("unknown primary " + ctx.getClass())
}

private fn buildConditional(ctx: IfPrimaryContext) -> Expr {
    val thenExpr = buildExpr(ctx.expression(1))
    val otherwise = buildExpr(ctx.expression(2))
    for (branch in List.of(thenExpr, otherwise)) {
        if (branch is Expr.Lambda) {
            throw Rejected(branch.pos(), "an `if` that gives a value takes expressions after `if (...)` and `else`, " +
                "not braces; put a lambda in parentheses")
        }
    }
    return Conditional(pos(ctx.start), buildExpr(ctx.expression(0)), thenExpr, otherwise)
}

private fn buildGenericNew(ctx: GenericConstructorContext) -> Expr {
    val typeArgs = ctx.typeArgs().type() |> map { t -> buildType(t) }
    val path = ctx.qualifiedName().identifier() |> map { i -> nameOf(i) }
    return GenericNew(pos(ctx.start), String.join(".", path), typeArgs, buildArguments(ctx.arguments()))
}

private fn buildWhen(ctx: WhenExpressionContext) -> Expr {
    val arms = ArrayList<Expr.Arm>()
    for (arm in ctx.whenArm()) {
        arms.add(buildArm(arm))
    }
    val binding = ctx.identifier()
    val bindingName: String? = if (binding == null) null else nameOf(binding)
    val bindingPos: Pos? = if (binding == null) null else pos(binding.start)
    return When(pos(ctx.start), bindingName, bindingPos, buildExpr(ctx.expression()), arms, pos(ctx.stop))
}

private fn buildArm(arm: WhenArmContext) -> Expr.Arm {
    val conditions = ArrayList<Expr.Cond>()
    for (condition in arm.whenCondition()) {
        conditions.add(buildCondition(condition))
    }
    val blockCtx = arm.block()
    val body: List<Stmt> = if (blockCtx != null) buildStatements(blockCtx.statement()) else List.of(armStatement(arm))
    return Arm(pos(arm.start), conditions, body, blockCtx != null)
}

/** The one statement of an arm without braces: its value, or a jump, a `return` or an assignment, statements elsewhere too. */
private fn armStatement(arm: WhenArmContext) -> Stmt {
    val returnWord = arm.RETURN()
    if (returnWord != null) {
        val value = arm.expression()
        return Return(pos(returnWord.getSymbol()), if (value == null) null else buildExpr(value))
    }
    val breakWord = arm.BREAK()
    if (breakWord != null) {
        return Stmt.Jump(pos(breakWord.getSymbol()), true)
    }
    val continueWord = arm.CONTINUE()
    if (continueWord != null) {
        return Stmt.Jump(pos(continueWord.getSymbol()), false)
    }
    val op = arm.assignOp()
    if (op != null) {
        return assignment(pos(arm.postfixExpression().start), arm.postfixExpression(), op, arm.expression())
    }
    return ExprStmt(pos(arm.expression().start), buildExpr(arm.expression()))
}

private fn buildCondition(condition: WhenConditionContext) -> Expr.Cond {
    if (condition.IS() != null) {
        val type = condition.qualifiedName()
        return Cond(pos(condition.start), TypeRef(pos(type.start), type.getText(), List.of(), false), null)
    }
    // A literal, a negative number or the name of a constant such as `Color.RED`, as Java writes them too.
    return Cond(pos(condition.start), null, Literal(pos(condition.start), condition.getText()))
}

private fn buildLambda(ctx: LambdaContext) -> Expr.Lambda {
    val params = ArrayList<Expr.Param>()
    for (p in ctx.lambdaParam()) {
        params.add(Param(pos(p.start), nameOf(p.identifier()), typeOrNull(p.type()), List.of()))
    }
    return Lambda(pos(ctx.start), params, ctx.ARROW() != null, buildStatements(ctx.statement()), pos(ctx.stop))
}

private fn typeOrNull(ctx: TypeContext?) -> TypeRef? {
    if (ctx == null) {
        return null
    }
    return buildType(ctx)
}

private fn buildType(ctx: TypeContext) -> TypeRef {
    val args = ctx.typeArg() |> map { t -> buildTypeArg(t) }
    return TypeRef(pos(ctx.start), ctx.qualifiedName().getText(), args, ctx.QUESTION() != null)
}

private fn buildTypeArg(ctx: TypeArgContext) -> TypeRef {
    val type = ctx.type()
    return if (type != null) buildType(type) else TypeRef(pos(ctx.start), TypeRef.ANY, List.of(), false)
}

private fn nameOf(ctx: IdentifierContext) -> String = ctx.getText()
