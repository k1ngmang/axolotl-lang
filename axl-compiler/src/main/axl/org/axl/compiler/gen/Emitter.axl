package org.axl.compiler.gen

import java.util.ArrayList
import java.util.Arrays
import java.util.List

/* Writes Java line by line and remembers which .axl line produced each one. */
class Emitter {

    private val out: StringBuilder = StringBuilder()
    private val lines: ArrayList<Int> = ArrayList<Int>()
    private var depth: Int = 0

    fn indent() {
        depth += 1
    }

    fn dedent() {
        depth -= 1
    }

    fn blank() {
        out.append('\n')
        lines.add(0)
    }

    /** Emits code that may span several lines when it contains a block lambda. */
    fn line(axlLine: Int, code: String) {
        val parts = Arrays.asList(code.split("\n", -1))
        write(axlLine, parts.get(0))
        for (part in parts.subList(1, parts.size())) {
            val mark = part.indexOf(markChar, 1)
            write(Integer.parseInt(part.substring(1, mark)), part.substring(mark + 1))
        }
    }

    private fn write(axlLine: Int, code: String) {
        out.append(indentation.repeat(depth)).append(code).append('\n')
        lines.add(axlLine)
    }

    /**
     * Renders what was emitted as text for embedding in an expression of an enclosing emitter;
     * every line keeps its .axl line and its indentation relative to that emitter.
     */
    fn embedded() -> String {
        if (out.isEmpty()) {
            return ""
        }
        val sb = StringBuilder()
        var index = 0
        for (line in Arrays.asList(out.toString().split("\n"))) {
            sb.append('\n').append(markChar).append(lines.get(index)).append(markChar).append(line)
            index += 1
        }
        return sb.toString()
    }

    fn text() -> String = out.toString()

    /** The .axl line of each Java line, 0 for none. */
    fn lineNumbers() -> List<Int> = lines
}

private val indentation: String = "    "

// Separates the .axl line number from the code in multi-line expression text.
private val markChar: Character = '\u0000'

fn continuation(axlLine: Int, code: String) -> String = "\n" + markChar + axlLine + markChar + code

/** A continuation line of an expression, indented twice. */
fn continued(axlLine: Int, code: String) -> String = continuation(axlLine, indentation + indentation + code)
