package org.axl.compiler.gen

import java.util.ArrayList
import java.util.HashMap
import java.util.HashSet
import java.util.List
import java.util.Map
import java.util.Set
import org.axl.compiler.ast.Decl
import org.axl.compiler.ast.Expr
import org.axl.compiler.ast.SourceFile
import org.axl.compiler.ast.Stmt
import org.axl.compiler.ast.TypeRef
import org.axl.compiler.check.TypeInference

/**
 * The names some code reads: as a name, as a name inside a lambda it writes, and as the member of a value. Whether a
 * private class parameter needs a field depends on where it is read.
 */
class Reads {

    val names: Set<String> = HashSet<String>()
    val inLambdas: Set<String> = HashSet<String>()
    val members: Set<String> = HashSet<String>()
    val assigned: Set<String> = HashSet<String>()

    // Depth of the lambdas being looked into.
    var lambdas: Int = 0

    /** Whether the lambdas Java gets for `?:`, `?.` and `attempt` count as lambdas too. */
    var expansions: Boolean = false

    /**
     * When set, `members` holds only the member reads that may be of this class: through `this` in its own code,
     * or through a value whose type is the class or not known. file and siblings are the build being read.
     */
    var memberOf: Decl.ClassDecl? = null
    var file: SourceFile? = null
    var siblings: List<SourceFile> = List.of()
    // The type whose code is read, with the types of its members and of the parameters and locals so far.
    var owner: Decl? = null
    var ownerTypes: Map<String, TypeRef> = Map.of()
    val locals: HashMap<String, TypeRef?> = HashMap<String, TypeRef?>()

    fn expr(e: Expr) {
        when (e) {
            is Expr.Literal -> { }
            is Expr.Name -> {
                if (lambdas > 0) {
                    inLambdas.add(e.name())
                } else {
                    names.add(e.name())
                }
            }
            is Expr.Member -> {
                if (readsMember(e)) {
                    members.add(e.name())
                }
                expanded(e.safe(), { -> expr(e.target()) })
            }
            is Expr.Call -> expanded(e.safe(), { ->
                val target = e.target()
                if (target != null) {
                    expr(target)
                }
                exprs(e.args())
            })
            is Expr.GenericNew -> exprs(e.args())
            is Expr.MethodRef -> expr(e.target())
            is Expr.ClassLiteral -> { }
            is Expr.NotNull -> expr(e.target())
            is Expr.Unary -> expr(e.operand())
            is Expr.Binary -> {
                expr(e.left())
                expr(e.right())
            }
            is Expr.Elvis -> expanded(true, { ->
                expr(e.left())
                expr(e.right())
            })
            is Expr.Is -> expr(e.target())
            is Expr.Conditional -> {
                expr(e.condition())
                expr(e.then())
                expr(e.otherwise())
            }
            is Expr.Throw -> expr(e.value())
            is Expr.When -> {
                expr(e.subject())
                for (arm in e.arms()) {
                    statements(arm.body())
                }
            }
            is Expr.Paren -> expr(e.inner())
            is Expr.Try -> expr(e.inner())
            is Expr.Attempt -> expanded(true, { ->
                expr(e.body())
                expr(e.handler())
            })
            is Expr.Lambda -> {
                for (p in e.params()) {
                    locals.put(p.name(), p.type())
                }
                lambdas += 1
                statements(e.body())
                lambdas -= 1
            }
            is Expr.Pipe -> {
                expr(e.source())
                for (stage in e.stages()) {
                    exprs(stage.args())
                    val lambda = stage.lambda()
                    if (lambda != null) {
                        expr(lambda)
                    }
                }
            }
        }
    }

    /** `other.limit` may read the parameter `limit` of the class `memberOf` when `other` is one, or may be. */
    private fn readsMember(e: Expr.Member) -> Boolean {
        val c = memberOf
        val inFile = file
        if (c == null || inFile == null) {
            return true
        }
        val target = e.target()
        if (target is Expr.Name && target.name().equals("this")) {
            return c.equals(owner)
        }
        if (target is Expr.Name && locals.containsKey(target.name()) && locals.get(target.name()) == null) {
            return true
        }
        val type = TypeInference(inFile, knownTypes(), siblings).of(target)
        return type == null || type.name().substring(type.name().lastIndexOf('.') + 1).equals(c.name())
    }

    private fn knownTypes() -> Map<String, TypeRef> {
        val known = HashMap<String, TypeRef>(ownerTypes)
        for (local in locals.entrySet()) {
            val type = local.getValue()
            if (type != null) {
                known.put(local.getKey(), type)
            } else {
                known.remove(local.getKey())
            }
        }
        return known
    }

    private fn expanded(lambda: Boolean, visit: Runnable) {
        val counts = lambda && expansions
        if (counts) {
            lambdas += 1
        }
        visit.run()
        if (counts) {
            lambdas -= 1
        }
    }

    fn exprs(list: List<Expr>) {
        for (e in list) {
            expr(e)
        }
    }

    fn statements(list: List<Stmt>) {
        for (s in list) {
            statement(s)
        }
    }

    fn statement(s: Stmt) {
        when (s) {
            is Stmt.Local -> {
                expr(s.init())
                locals.put(s.name(), s.type() ?: localType(s.init()))
            }
            is Stmt.Assign -> {
                val target = s.target()
                if (target is Expr.Name) {
                    assigned.add(target.name())
                }
                expr(target)
                expr(s.value())
            }
            is Stmt.Return -> {
                val value = s.value()
                if (value != null) {
                    expr(value)
                }
            }
            is Stmt.Jump -> { }
            is Stmt.AttemptExit -> {
                expanded(true, { -> expr(s.body()) })
                statement(s.exit())
            }
            is Stmt.Use -> {
                expr(s.resource())
                locals.put(s.name(), s.type() ?: localType(s.resource()))
                statement(s.body())
                val handler = s.handler()
                if (handler != null) {
                    expr(handler)
                }
            }
            is Stmt.If -> {
                expr(s.condition())
                statement(s.then())
                val otherwise = s.elseBranch()
                if (otherwise != null) {
                    statement(otherwise)
                }
            }
            is Stmt.While -> {
                expr(s.condition())
                statement(s.body())
            }
            is Stmt.For -> {
                expr(s.iterable())
                locals.put(s.name(), null)
                statement(s.body())
            }
            is Stmt.Count -> {
                locals.put(s.name(), null)
                expr(s.from())
                expr(s.to())
                val step = s.step()
                if (step != null) {
                    expr(step)
                }
                statement(s.body())
            }
            is Stmt.ExprStmt -> expr(s.expr())
            is Stmt.Block -> statements(s.statements())
        }
    }

    /** The type of a local's value, when member reads are resolved; null otherwise or when not known. */
    private fn localType(init: Expr) -> TypeRef? {
        val inFile = file
        if (memberOf == null || inFile == null) {
            return null
        }
        return TypeInference(inFile, knownTypes(), siblings).of(init)
    }

    fn function(f: Decl.Function) {
        locals.clear()
        for (p in f.params()) {
            locals.put(p.name(), p.type())
        }
        val exprBody = f.exprBody()
        if (exprBody != null) {
            expr(exprBody)
        }
        val body = f.body()
        if (body != null) {
            statement(body)
        }
    }

    fn decl(d: Decl) {
        locals.clear()
        owner = d
        val inFile = file
        if (memberOf != null && inFile != null) {
            ownerTypes = ownerTypesOf(d, inFile, siblings)
        }
        when (d) {
            is Decl.Function -> function(d)
            is Decl.Value -> expr(d.init())
            is Decl.DataClass -> {
                for (m in d.methods()) {
                    function(m)
                }
            }
            is Decl.Interface -> {
                for (m in d.methods()) {
                    function(m)
                }
            }
            is Decl.EnumDecl -> {
                for (args in d.arguments()) {
                    exprs(args)
                }
                for (m in d.methods()) {
                    function(m)
                }
            }
            is Decl.ClassDecl -> {
                val superArgs = d.superArgs()
                if (superArgs != null) {
                    exprs(superArgs)
                }
                for (p in d.properties()) {
                    val init = p.init()
                    if (init != null) {
                        expr(init)
                    }
                }
                for (k in d.constructors()) {
                    exprs(k.args())
                }
                for (m in d.methods()) {
                    function(m)
                }
            }
        }
    }
}

/** The members of a class or data class with their types, which its code reads by name. */
private fn ownerTypesOf(d: Decl, file: SourceFile, siblings: List<SourceFile>) -> Map<String, TypeRef> {
    val types = HashMap<String, TypeRef>()
    if (d is Decl.ClassDecl) {
        types.putAll(TypeInference.propertyTypes(file, siblings, d))
    } else if (d is Decl.DataClass) {
        for (f in d.fields()) {
            val type = f.type()
            if (type != null) {
                types.put(f.name(), type)
            }
        }
    }
    return types
}

/**
 * The private `val` parameters of a class that only its constructor reads, in the values of properties and of the
 * superclass: they need no field, which Error Prone would report as never read. A parameter keeps its field when a
 * method, a lambda written in a property or another constructor reads its name, when a file of the build reads a
 * member of that name through `this` in the class or through a value that is or may be of the class (javac then
 * reports a read from outside the class as private), when an interface requires a value of that name, when it carries
 * annotations, which Java puts on the field, and when nothing reads it, which Error Prone reports.
 */
fn constructorOnly(c: Decl.ClassDecl, file: SourceFile, siblings: List<SourceFile>, required: Set<String>) -> Set<String> {
    val result = HashSet<String>()
    for (p in c.parameters()) {
        if (p.isPrivate() && !p.mutable() && p.annotations().isEmpty() && !required.contains(p.name())) {
            result.add(p.name())
        }
    }
    if (result.isEmpty()) {
        return result
    }
    val inMethods = Reads()
    for (m in c.methods()) {
        inMethods.function(m)
    }
    result.removeAll(inMethods.names)
    result.removeAll(inMethods.inLambdas)
    // `this(...)` sees its constructor's parameters; another name there is a field, which javac reports.
    for (k in c.constructors()) {
        val inConstructor = Reads()
        inConstructor.exprs(k.args())
        for (p in k.params()) {
            inConstructor.names.remove(p.name())
            inConstructor.inLambdas.remove(p.name())
        }
        result.removeAll(inConstructor.names)
        result.removeAll(inConstructor.inLambdas)
    }
    val inProperties = Reads()
    for (p in c.properties()) {
        val init = p.init()
        if (init != null) {
            inProperties.expr(init)
        }
    }
    val superArgs = c.superArgs()
    if (superArgs != null) {
        inProperties.exprs(superArgs)
    }
    result.removeAll(inProperties.inLambdas)
    // A parameter that nothing reads keeps its field, which Error Prone reports as never read.
    result.retainAll(inProperties.names)
    if (result.isEmpty()) {
        return result
    }
    val inBuild = Reads()
    inBuild.memberOf = c
    inBuild.siblings = with(file, siblings)
    for (f in inBuild.siblings) {
        inBuild.file = f
        for (d in f.decls()) {
            inBuild.decl(d)
        }
    }
    result.removeAll(inBuild.members)
    return result
}

private fn with(file: SourceFile, siblings: List<SourceFile>) -> List<SourceFile> {
    val files = ArrayList<SourceFile>(siblings)
    files.add(file)
    return files
}
