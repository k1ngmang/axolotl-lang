package org.axl.compiler.ast

import java.util.List

sealed interface Decl {
    val pos: Pos

    /** Where the declared name is, for errors about the name. */
    val namePos: Pos

    val name: String

    val isPrivate: Boolean

    val annotations: List<Annotation>
}

/** `@Name(args)` before a declaration; the generated Java carries it as it is. */
data class Annotation(val pos: Pos, val name: String, val args: List<AnnotationArg>)

/** `name = value` or a bare value; `elements` holds the values of `{ a, b }`, with no value then. */
data class AnnotationArg(val name: String?, val value: Expr?, val elements: List<AnnotationArg>)

/** Exactly one of exprBody and body is set; returnType is null for void. */
data class Function(
    val pos: Pos,
    val namePos: Pos,
    val isPrivate: Boolean,
    val name: String,
    val params: List<Expr.Param>,
    val returnType: TypeRef?,
    val exprBody: Expr?,
    val body: Stmt.Block?,
    val annotations: List<Annotation>
) : Decl

data class Value(
    val pos: Pos,
    val namePos: Pos,
    val isPrivate: Boolean,
    val name: String,
    val type: TypeRef?,
    val init: Expr,
    val annotations: List<Annotation>
) : Decl

/** An immutable class: a Java record. supertypes are interfaces of the same file. */
data class DataClass(
    val pos: Pos,
    val namePos: Pos,
    val isPrivate: Boolean,
    val name: String,
    val fields: List<Expr.Param>,
    val supertypes: List<TypeRef>,
    val annotations: List<Annotation>
) : Decl

/** members are the values it requires, such as `val pos: Pos`. */
data class Interface(
    val pos: Pos,
    val namePos: Pos,
    val isPrivate: Boolean,
    val name: String,
    val isSealed: Boolean,
    val members: List<Expr.Param>,
    /** Signatures without a body: a class that implements the interface writes each. */
    val methods: List<Function>,
    val supertypes: List<TypeRef>,
    val annotations: List<Annotation>
) : Decl

/**
 * A class with state and methods. A property without init is a parameter of the constructor; methods
 * are functions that read the properties by name.
 */
data class ClassDecl(
    val pos: Pos,
    val namePos: Pos,
    val isPrivate: Boolean,
    val name: String,
    val parameters: List<Property>,
    val properties: List<Property>,
    val methods: List<Function>,
    val supertypes: List<TypeRef>,
    val annotations: List<Annotation>
) : Decl

/** An enumeration of constants without members. */
data class EnumDecl(
    val pos: Pos,
    val namePos: Pos,
    val isPrivate: Boolean,
    val name: String,
    val constants: List<String>,
    val annotations: List<Annotation>
) : Decl

data class Property(
    val pos: Pos,
    val namePos: Pos,
    val isPrivate: Boolean,
    val name: String,
    val type: TypeRef?,
    val init: Expr?,
    val mutable: Boolean,
    val annotations: List<Annotation>
)
