package org.axl.compiler.ast

import java.util.List

sealed interface Stmt {
    val pos: Pos
}

/** `val` or `var`; type is null when it is left to javac. */
data class Local(
    val pos: Pos,
    val namePos: Pos,
    val name: String,
    val type: TypeRef?,
    val init: Expr,
    val mutable: Boolean
) : Stmt

data class Assign(val pos: Pos, val target: Expr, val op: String, val value: Expr) : Stmt

data class Return(val pos: Pos, val value: Expr?) : Stmt

/**
 * `use (val reader = open()) { ... } else e -> handler`: the resource is closed after the block, and the
 * handler, a call or a `throw`, runs when opening, the block or closing throws. handler is null without `else`.
 */
data class Use(
    val pos: Pos,
    val namePos: Pos,
    val name: String,
    val type: TypeRef?,
    val resource: Expr,
    val body: Block,
    val errorName: String?,
    val errorNamePos: Pos?,
    val handler: Expr?
) : Stmt

/** `break` or `continue`, inside a loop. */
data class Jump(val pos: Pos, val isBreak: Boolean) : Stmt

/**
 * `attempt call() else e -> exit` on a line of its own, where exit, a Jump or a Return, leaves the loop or the
 * function when the call throws. errorName and errorNamePos are null without `e ->`.
 */
data class AttemptExit(
    val pos: Pos,
    val body: Expr,
    val errorName: String?,
    val errorNamePos: Pos?,
    val exit: Stmt
) : Stmt

/** elseBranch is null, a Block or another If. */
data class If(val pos: Pos, val condition: Expr, val then: Block, val elseBranch: Stmt?) : Stmt

data class While(val pos: Pos, val condition: Expr, val body: Block) : Stmt

/** `for (name in iterable) { ... }`. */
data class For(val pos: Pos, val namePos: Pos, val name: String, val iterable: Expr, val body: Block) : Stmt

data class ExprStmt(val pos: Pos, val expr: Expr) : Stmt

data class Block(val pos: Pos, val statements: List<Stmt>, val end: Pos) : Stmt
