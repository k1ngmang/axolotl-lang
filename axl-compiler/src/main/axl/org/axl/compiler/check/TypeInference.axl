package org.axl.compiler.check

import java.util.ArrayList
import java.util.HashMap
import java.util.HashSet
import java.util.List
import java.util.Map
import java.util.Set
import org.axl.compiler.JavaClasses
import org.axl.compiler.ast.Decl
import org.axl.compiler.ast.Expr
import org.axl.compiler.ast.Import
import org.axl.compiler.ast.Pos
import org.axl.compiler.ast.SourceFile
import org.axl.compiler.ast.TypeRef

/**
 * The type of a top-level `val` without a written type, from what the file itself says: literals,
 * operators, constructors, other values and the result types of its functions. Anything that needs
 * the classpath is left to javac (see JavaTypes).
 */
class TypeInference(val file: SourceFile, val known: Map<String, TypeRef>, val siblings: List<SourceFile>) {

    val inProgress: HashSet<String> = HashSet<String>()

    /** The methods of the class whose properties are being typed: a call without a receiver may be to one. */
    var methods: List<Decl.Function> = List.of()

    /** The classes of the classpath, whose methods may tell a primitive result; null where only the build counts. */
    var classes: JavaClasses? = null

    fn value(value: Decl.Value) -> TypeRef? {
        if (value.type() != null) {
            return value.type()
        }
        if (known.containsKey(value.name())) {
            return known.get(value.name())
        }
        if (!inProgress.add(value.name())) {
            return null
        }
        val type = of(value.init())
        inProgress.remove(value.name())
        return type
    }

    fn of(expr: Expr) -> TypeRef? = when (expr) {
        is Expr.Literal -> literal(expr)
        is Expr.Paren -> of(expr.inner())
        is Expr.Unary -> if (expr.op().equals("!")) simple("Boolean", expr.pos()) else of(expr.operand())
        is Expr.Binary -> binary(expr)
        is Expr.Elvis -> elvis(expr)
        is Expr.Is -> simple("Boolean", expr.pos())
        is Expr.Name -> known.get(expr.name()) ?: topLevelValue(expr.name())
        is Expr.Call -> if (expr.target() == null) call(expr) else (siblingCall(expr) ?: member(expr))
        is Expr.Member -> field(expr)
        is Expr.GenericNew -> if (expr.typeArgs().isEmpty()) null else TypeRef(expr.pos(), expr.type(), expr.typeArgs(), false)
        is Expr.NotNull -> nonNull(of(expr.target()))
        is Expr.Conditional -> common(of(expr.then()), of(expr.otherwise()))
        is Expr.Try -> okType(of(expr.inner()))
        is Expr.ClassLiteral -> classOf(expr)
        is Expr.Attempt -> if (throwsInstead(expr)) of(expr.body()) else resultOf(of(expr.body()), of(expr.handler()), expr.pos())
        else -> null
    }

    private fn classOf(e: Expr.ClassLiteral) -> TypeRef? {
        val name = Expr.pathName(e.target())
        return if (name == null) null else TypeRef(e.pos(), "Class", List.of(simple(name, e.pos())), false)
    }

    /** The value type of a `Result<T, E>`. */
    private fn okType(result: TypeRef?) -> TypeRef? {
        if (result == null || !(result.name().equals("Result") || result.name().equals("axl.lang.Result")) || result.args().size() != 2) {
            return null
        }
        return result.args().getFirst()
    }

    /** The type of two branches when they have the same simple type, such as `Int` and `Int?`. */
    private fn common(a: TypeRef?, b: TypeRef?) -> TypeRef? {
        if (a == null || b == null || !a.name().equals(b.name()) || !a.args().isEmpty() || !b.args().isEmpty()) {
            return null
        }
        return TypeRef(a.pos(), a.name(), a.args(), a.nullable() || b.nullable())
    }

    private fn literal(l: Expr.Literal) -> TypeRef? {
        val text = l.text()
        if (text.startsWith("\"")) {
            return simple("String", l.pos())
        }
        if (text.equals("true") || text.equals("false")) {
            return simple("Boolean", l.pos())
        }
        if (text.equals("null") || text.startsWith("'")) {
            return null
        }
        val last = Character.toLowerCase(text.charAt(text.length() - 1))
        if (last == 'l') {
            return simple("Long", l.pos())
        }
        val hex = text.startsWith("0x") || text.startsWith("0X")
        if (!hex && (text.contains(".") || text.contains("e") || text.contains("E") || last == 'd')) {
            return simple(if (last == 'f') "Float" else "Double", l.pos())
        }
        return simple(if (last == 'f' && !hex) "Float" else "Int", l.pos())
    }

    private fn binary(b: Expr.Binary) -> TypeRef? {
        if (comparisons.contains(b.op())) {
            return simple("Boolean", b.pos())
        }
        val left = of(b.left())
        val right = of(b.right())
        if (b.op().equals("+") && (isString(left) || isString(right))) {
            return simple("String", b.pos())
        }
        if (left == null || right == null || !numbers.contains(left.name()) || !numbers.contains(right.name())) {
            return null
        }
        return if (numbers.indexOf(left.name()) >= numbers.indexOf(right.name())) nonNull(left) else nonNull(right)
    }

    /** `a ?: b` has the type of `b` when both sides agree; otherwise javac decides. */
    private fn elvis(e: Expr.Elvis) -> TypeRef? {
        val left = of(e.left())
        if (isThrow(e.right())) {
            return if (left == null) null else TypeRef(left.pos(), left.name(), left.args(), false)
        }
        val right = of(e.right())
        return if (right != null && left != null && sameType(left, right)) right else null
    }

    private fn call(c: Expr.Call) -> TypeRef? {
        val own = methods |> filter { m -> m.name().equals(c.name()) && m.params().size() == c.args().size() }
        if (!own.isEmpty()) {
            // A type parameter of the method is not a type the property can have.
            return if (own.size() == 1 && own.getFirst().typeParams().isEmpty()) own.getFirst().returnType() else null
        }
        val candidates = ArrayList<Decl.Function>()
        for (decl in file.decls()) {
            if (decl is Decl.Function && decl.name().equals(c.name()) && decl.params().size() == c.args().size()) {
                candidates.add(decl)
            }
        }
        if (candidates.size() == 1) {
            return candidates.getFirst().returnType()
        }
        if (candidates.size() > 1 || isImportedFunction(c.name())) {
            return null
        }
        if (Character.isUpperCase(c.name().charAt(0)) && !c.name().equals("Ok") && !c.name().equals("Err")) {
            return simple(c.name(), c.pos())
        }
        return null
    }

    /** `Parse.number(s)`: what the function of that file of the build returns, when the file is known. */
    private fn siblingCall(c: Expr.Call) -> TypeRef? {
        val target = c.target()
        if (target !is Expr.Name || c.safe()) {
            return null
        }
        for (sibling in siblings) {
            if (sibling.className().equals(target.name()) && samePackage(sibling)) {
                val candidates = ArrayList<Decl.Function>()
                for (decl in sibling.decls()) {
                    if (decl is Decl.Function && !decl.isPrivate() && decl.name().equals(c.name()) && decl.params().size() == c.args().size()) {
                        candidates.add(decl)
                    }
                }
                val type = if (candidates.size() == 1) candidates.getFirst().returnType() else null
                return if (type == null) null else asWrittenHere(type, sibling)
            }
        }
        return null
    }

    /**
     * A type written in another file of the build, with the names that file imports or declares inside its own
     * class written out where this file does not import them, so that the Java of this file can name it:
     * `java.util.List<String>` for `List<String>`.
     */
    private fn asWrittenHere(type: TypeRef, owner: SourceFile) -> TypeRef {
        if (owner.path().equals(file.path())) {
            return type
        }
        val name = type.name()
        val qualified = if (name.contains(".")) null else qualifiedIn(name, owner)
        val imported = qualified != null && (file.imports() |> anyMatch { i -> i.kind() == Import.Kind.TYPE && i.name().equals(qualified) })
        val written = if (qualified == null || imported) name else qualified
        return TypeRef(type.pos(), written, type.args() |> map { a -> asWrittenHere(a, owner) }, type.nullable())
    }

    /** The qualified name of a type that a file names by its simple name: one it imports or declares inside its own class. */
    private fn qualifiedIn(name: String, owner: SourceFile) -> String? {
        val imported = owner.imports() |> filter { i -> i.kind() == Import.Kind.TYPE && i.simpleName().equals(name) } |> first
        if (imported != null) {
            return imported.name()
        }
        val nested = !name.equals(owner.className()) && (owner.decls() |> anyMatch { d -> isType(d) && d.name().equals(name) })
        if (!nested) {
            return null
        }
        val packageName = owner.packageName()
        return (if (packageName == null) "" else packageName + ".") + owner.className() + "." + name
    }

    /** The file of the build that declares a type that `typeNamed` found. */
    private fn declaringFile(decl: Decl) -> SourceFile {
        if (file.decls().contains(decl)) {
            return file
        }
        for (sibling in siblings) {
            if (samePackage(sibling) && sibling.decls().contains(decl)) {
                return sibling
            }
        }
        return file
    }

    private fn samePackage(other: SourceFile) -> Boolean {
        val own = file.packageName()
        val theirs = other.packageName()
        return if (own == null) theirs == null else own.equals(theirs)
    }

    /**
     * `p.x()` on a data class or class of the build, `s.length()` on a String, `System.nanoTime()`: what
     * the receiver's declaration or the JDK's gives, when the receiver's type is known.
     */
    private fn member(c: Expr.Call) -> TypeRef? {
        val target = c.target()
        if (target == null) {
            return null
        }
        if (target is Expr.Name && Character.isUpperCase(target.name().charAt(0)) && !known.containsKey(target.name())) {
            return staticCall(target.name(), c)
        }
        val receiver = of(target)
        if (receiver == null) {
            return null
        }
        val own = if (c.args().isEmpty()) fieldOf(receiver, c.name()) else null
        val type = own ?: (methodOf(receiver, c) ?: (jdkMethod(receiver, c) ?: classpathMethod(receiver.name(), c)))
        return if (type == null || !c.safe()) type else TypeRef(type.pos(), type.name(), type.args(), true)
    }

    /** `options.columnWidth`: the written type of that field of a data class or class of the build. */
    private fn field(m: Expr.Member) -> TypeRef? {
        val receiver = of(m.target())
        val type = if (receiver == null) null else fieldOf(receiver, m.name())
        return if (type == null || !m.safe()) type else TypeRef(type.pos(), type.name(), type.args(), true)
    }

    /** The written result of the one method of that name and arity of a type of the build, with the receiver's type arguments. */
    private fn methodOf(receiver: TypeRef, c: Expr.Call) -> TypeRef? {
        val decl = typeNamed(receiver.name())
        if (decl == null) {
            return null
        }
        val params = typeParamsOf(decl)
        if (!params.isEmpty() && params.size() != receiver.args().size()) {
            return null
        }
        // `q.left()` for `val left: T` of the interface.
        val value = if (decl is Decl.Interface && c.args().isEmpty()) decl.members() |> filter { m -> m.name().equals(c.name()) } |> first else null
        val valueType = value?.type()
        if (valueType != null) {
            return Implementations.substitute(asWrittenHere(valueType, declaringFile(decl)), params, receiver.args())
        }
        val methods: List<Decl.Function> = when (decl) {
            is Decl.DataClass -> decl.methods()
            is Decl.ClassDecl -> decl.methods()
            is Decl.Interface -> decl.methods()
            else -> List.of()
        }
        val named = methods |> filter { m -> m.name().equals(c.name()) && m.params().size() == c.args().size() }
        // A type parameter of the method is not a type the property can have.
        if (named.size() != 1 || !named.getFirst().typeParams().isEmpty()) {
            return null
        }
        val type = named.getFirst().returnType()
        return if (type == null) null else Implementations.substitute(asWrittenHere(type, declaringFile(decl)), params, receiver.args())
    }

    /** The field a data class or class of the build gives under this name, with the receiver's type arguments. */
    private fn fieldOf(receiver: TypeRef, name: String) -> TypeRef? {
        val decl = typeNamed(receiver.name())
        if (decl == null) {
            return null
        }
        val params = typeParamsOf(decl)
        if (!params.isEmpty() && params.size() != receiver.args().size()) {
            return null
        }
        val field = fieldsOf(decl) |> filter { f -> f.name().equals(name) } |> first
        val type = field?.type()
        return if (type == null) null else Implementations.substitute(asWrittenHere(type, declaringFile(decl)), params, receiver.args())
    }

    private fn typeNamed(name: String) -> Decl? {
        val simple = simpleName(name)
        for (decl in file.decls()) {
            if ((decl is Decl.DataClass || decl is Decl.ClassDecl || decl is Decl.Interface) && decl.name().equals(simple)) {
                return decl
            }
        }
        for (sibling in siblings) {
            if (samePackage(sibling)) {
                for (decl in sibling.decls()) {
                    if ((decl is Decl.DataClass || decl is Decl.ClassDecl || decl is Decl.Interface) && decl.name().equals(simple)) {
                        return decl
                    }
                }
            }
        }
        return null
    }

    /** A few methods of the types every program uses, typed as javac types them. */
    private fn jdkMethod(receiver: TypeRef, c: Expr.Call) -> TypeRef? {
        val name = c.name()
        val owner = simpleName(receiver.name())
        val pos = c.pos()
        val arity = c.args().size()
        if (name.equals("toString") && arity == 0) {
            return simple("String", pos)
        }
        if (name.equals("hashCode") && arity == 0) {
            return simple("Int", pos)
        }
        if (name.equals("equals") && arity == 1) {
            return simple("Boolean", pos)
        }
        if (owner.equals("String")) {
            if (STRING_STRINGS.contains(name)) {
                return simple("String", pos)
            }
            if (STRING_INTS.contains(name)) {
                return simple("Int", pos)
            }
            if (STRING_BOOLEANS.contains(name)) {
                return simple("Boolean", pos)
            }
            if (name.equals("lines") && arity == 0) {
                return TypeRef(pos, STREAM, List.of(simple("String", pos)), false)
            }
            return if (name.equals("charAt")) simple("Character", pos) else null
        }
        if (COLLECTIONS.contains(owner)) {
            if (name.equals("stream") && arity == 0) {
                return if (receiver.args().size() == 1) TypeRef(pos, STREAM, receiver.args(), false) else null
            }
            if (name.equals("size") || name.equals("indexOf")) {
                return simple("Int", pos)
            }
            if (name.equals("isEmpty") || name.equals("contains") || name.equals("add")) {
                return simple("Boolean", pos)
            }
            if ((name.equals("subList") || name.equals("reversed")) && owner.equals("List")) {
                return nonNull(receiver)
            }
            val element = receiver.args().size() == 1 && arity <= 1 && (name.equals("get") || name.equals("getFirst") || name.equals("getLast"))
            return if (element) receiver.args().getFirst() else null
        }
        if (MAPS.contains(owner)) {
            if (name.equals("size")) {
                return simple("Int", pos)
            }
            if (name.equals("isEmpty") || name.equals("containsKey") || name.equals("containsValue")) {
                return simple("Boolean", pos)
            }
            if (receiver.args().size() != 2) {
                return null
            }
            val value = receiver.args().get(1)
            if (name.equals("keySet")) {
                return TypeRef(pos, "Set", List.of(receiver.args().get(0)), false)
            }
            if (name.equals("values")) {
                return TypeRef(pos, "Collection", List.of(value), false)
            }
            return if (name.equals("get") && arity == 1) TypeRef(pos, value.name(), value.args(), true) else null
        }
        return null
    }

    /** `System.nanoTime()`, `Math.max(a, b)`, `Integer.parseInt(s)`, `Instant.now()`: the JDK's static methods every program uses. */
    private fn staticCall(owner: String, c: Expr.Call) -> TypeRef? {
        val name = c.name()
        val pos = c.pos()
        val arity = c.args().size()
        if (owner.equals("System")) {
            if (name.equals("nanoTime") || name.equals("currentTimeMillis")) {
                return simple("Long", pos)
            }
            if (name.equals("lineSeparator")) {
                return simple("String", pos)
            }
            return if ((name.equals("getProperty") || name.equals("getenv")) && arity == 1) TypeRef(pos, "String", ArrayList<TypeRef>(), true) else null
        }
        if (owner.equals("Math")) {
            if (MATH_DOUBLES.contains(name)) {
                return simple("Double", pos)
            }
            if (name.equals("round") && arity == 1) {
                return simple(if ("Float".equals(of(c.args().getFirst())?.name())) "Int" else "Long", pos)
            }
            if (!(name.equals("max") || name.equals("min") || name.equals("abs")) || arity == 0) {
                return null
            }
            var widest: TypeRef? = null
            for (arg in c.args()) {
                val type = of(arg)
                if (type == null || !numbers.contains(type.name())) {
                    return null
                }
                widest = if (widest == null || numbers.indexOf(type.name()) > numbers.indexOf(widest.name())) nonNull(type) else widest
            }
            return widest
        }
        if (owner.equals("Integer") || owner.equals("Long") || owner.equals("Float") || owner.equals("Double") || owner.equals("Boolean")) {
            val own = if (owner.equals("Integer")) "Int" else owner
            if (name.startsWith("parse") || name.equals("valueOf") || name.equals("sum") || name.equals("max") || name.equals("min")) {
                return simple(own, pos)
            }
            if (name.equals("compare") || name.equals("signum") || name.equals("bitCount")) {
                return simple("Int", pos)
            }
            return if (name.equals("toString") || name.equals("toHexString") || name.equals("toBinaryString")) simple("String", pos) else null
        }
        if (owner.equals("Character")) {
            if (name.startsWith("is")) {
                return simple("Boolean", pos)
            }
            if (name.equals("toUpperCase") || name.equals("toLowerCase") || name.equals("valueOf")) {
                return simple("Character", pos)
            }
            return if (name.equals("getNumericValue") || name.equals("compare") || name.equals("digit")) simple("Int", pos) else null
        }
        if (owner.equals("String")) {
            return if (name.equals("valueOf") || name.equals("join") || name.equals("format")) simple("String", pos) else null
        }
        if (owner.equals("Objects")) {
            if (name.equals("equals") || name.equals("isNull") || name.equals("nonNull")) {
                return simple("Boolean", pos)
            }
            if (name.equals("hash") || name.equals("hashCode")) {
                return simple("Int", pos)
            }
            if (name.equals("toString")) {
                return simple("String", pos)
            }
            return if (name.equals("requireNonNull") && arity >= 1) nonNull(of(c.args().getFirst())) else null
        }
        if (owner.equals("List") || owner.equals("Set") || owner.equals("Stream")) {
            // `List.of()` without elements is typed by what it goes to, which javac decides.
            return if (name.equals("of") && arity > 0) elementsOf(owner, c.args(), pos) else null
        }
        // The streams of `Files`, which `|>` takes as they are.
        if (owner.equals("Files")) {
            if (name.equals("lines")) {
                return TypeRef(pos, STREAM, List.of(simple("String", pos)), false)
            }
            val paths = name.equals("list") || name.equals("walk") || name.equals("find")
            return if (paths) TypeRef(pos, STREAM, List.of(simple("java.nio.file.Path", pos)), false) else null
        }
        // The static methods of the JDK's value types give that type: `Instant.now()`, `Duration.ofMillis(5L)`, `Path.of("x")`.
        if (VALUE_TYPES.contains(owner)) {
            return simple(if (owner.equals("Paths")) "Path" else owner, pos)
        }
        return classpathMethod(owner, c)
    }

    /**
     * `reader.read()`, `Byte.toUnsignedInt(b)`: a method of a class of the classpath whose overloads of that
     * arity agree on a primitive result, which cannot be null. Other results keep the nullness Java gives them.
     */
    private fn classpathMethod(owner: String, c: Expr.Call) -> TypeRef? {
        val known = classes
        if (known == null || typeNamed(owner) != null) {
            return null
        }
        val library = Libraries.classNamed(file, known, owner)
        val result = if (library == null) null else known.result(library.name(), c.name(), c.args().size())
        val type = if (result == null) null else PRIMITIVE_RESULTS.get(result)
        return if (type == null) null else simple(type, c.pos())
    }

    /** `List.of(1, 2)` is a `List<Int>` when every element has that type. */
    private fn elementsOf(owner: String, args: List<Expr>, pos: Pos) -> TypeRef? {
        var element: TypeRef? = null
        for (arg in args) {
            val type = of(arg)
            if (type == null || type.nullable() || (element != null && !sameType(element, type))) {
                return null
            }
            element = type
        }
        return if (element == null) null else TypeRef(pos, owner, List.of(element), false)
    }

    private fn typeParamsOf(decl: Decl) -> List<Decl.TypeParam> = when (decl) {
        is Decl.DataClass -> decl.typeParams()
        is Decl.ClassDecl -> decl.typeParams()
        is Decl.Interface -> decl.typeParams()
        else -> List.of()
    }

    /** The fields of a data class, or the parameters and typed properties of a class, as read by `x.name()`. */
    private fn fieldsOf(decl: Decl) -> List<Expr.Param> = when (decl) {
        is Decl.DataClass -> decl.fields()
        is Decl.ClassDecl -> {
            val fields = ArrayList<Expr.Param>(decl.parameters() |> map { p -> Expr.Param(p.pos(), p.name(), p.type(), List.of()) })
            for (p in decl.properties()) {
                fields.add(Expr.Param(p.pos(), p.name(), p.type(), List.of()))
            }
            fields
        }
        else -> List.of()
    }

    private fn isImportedFunction(name: String) -> Boolean =
        file.imports().stream().anyMatch({ i -> i.kind() != Import.Kind.TYPE && i.simpleName().equals(name) })

    private fn topLevelValue(name: String) -> TypeRef? {
        for (decl in file.decls()) {
            if (decl is Decl.Value && decl.name().equals(name)) {
                return value(decl)
            }
        }
        return null
    }
}

private val numbers: List<String> = List.of("Int", "Long", "Float", "Double")

private val PRIMITIVE_RESULTS: Map<String, String> = Map.of("int", "Int", "long", "Long", "float", "Float", "double", "Double",
    "boolean", "Boolean", "char", "Character")

private val STRING_STRINGS: Set<String> = Set.of("toUpperCase", "toLowerCase", "trim", "strip", "stripLeading", "stripTrailing",
    "substring", "replace", "replaceAll", "replaceFirst", "repeat", "concat", "formatted", "intern", "indent")
private val STRING_INTS: Set<String> = Set.of("length", "indexOf", "lastIndexOf", "compareTo", "compareToIgnoreCase", "codePointAt")
private val STRING_BOOLEANS: Set<String> = Set.of("isEmpty", "isBlank", "startsWith", "endsWith", "contains", "equalsIgnoreCase",
    "matches", "contentEquals")
private val COLLECTIONS: Set<String> = Set.of("List", "ArrayList", "LinkedList", "Set", "HashSet", "LinkedHashSet", "TreeSet", "Collection")
private val MAPS: Set<String> = Set.of("Map", "HashMap", "LinkedHashMap", "TreeMap", "ConcurrentHashMap")
private val MATH_DOUBLES: Set<String> = Set.of("sqrt", "pow", "floor", "ceil", "random", "log", "log10", "exp", "sin", "cos", "tan",
    "atan2", "hypot", "cbrt", "rint", "toRadians", "toDegrees")
// Written out, since the file may not import it, nor `Path`.
private val STREAM = "java.util.stream.Stream"
private val VALUE_TYPES: Set<String> = Set.of("Instant", "Duration", "LocalDate", "LocalDateTime", "LocalTime", "ZonedDateTime",
    "Path", "Paths", "UUID", "BigDecimal", "BigInteger", "URI")

private fn simpleName(name: String) -> String = name.substring(name.lastIndexOf('.') + 1)

private fn isType(d: Decl) -> Boolean = d is Decl.DataClass || d is Decl.ClassDecl || d is Decl.Interface || d is Decl.EnumDecl

private val comparisons: List<String> = List.of("==", "!=", "<", "<=", ">", ">=", "&&", "||")

/** Infers every untyped top-level value it can; the result maps value names to types. */
fn inferAll(file: SourceFile, known: Map<String, TypeRef>) {
    val inference = TypeInference(file, known, List.of())
    for (decl in file.decls()) {
        if (decl is Decl.Value && decl.type() == null) {
            val type = inference.value(decl)
            if (type != null) {
                known.put(decl.name(), type)
            }
        }
    }
}

/** The type of an expression of the file as far as the file alone tells, or null. */
fn typeOf(file: SourceFile, expr: Expr) -> TypeRef? = TypeInference(file, HashMap<String, TypeRef>(), List.of()).of(expr)

/** The type of an expression, also through the functions of the other files of the build. */
fn typeOf(file: SourceFile, siblings: List<SourceFile>, expr: Expr) -> TypeRef? =
    TypeInference(file, HashMap<String, TypeRef>(), siblings).of(expr)

/**
 * The parameters and properties of a class with their types, written or told by their values, which
 * may read the parameters and the properties set before them: `val upper = label.toUpperCase()`.
 */
fn propertyTypes(file: SourceFile, siblings: List<SourceFile>, c: Decl.ClassDecl?) -> Map<String, TypeRef> {
    val result = HashMap<String, TypeRef>()
    if (c == null) {
        return result
    }
    for (p in c.parameters()) {
        val type = p.type()
        if (type != null) {
            result.put(p.name(), type)
        }
    }
    val inference = TypeInference(file, result, siblings)
    inference.methods = c.methods()
    for (p in c.properties()) {
        val init = p.init()
        val type = p.type() ?: (if (init == null) null else inference.of(init))
        if (type != null) {
            result.put(p.name(), type)
        }
    }
    return result
}

private fn sameType(a: TypeRef, b: TypeRef) -> Boolean {
    if (!a.name().equals(b.name()) || a.args().size() != b.args().size()) {
        return false
    }
    var i = 0
    while (i < a.args().size()) {
        val left = a.args().get(i)
        val right = b.args().get(i)
        if (!sameType(left, right) || left.nullable() != right.nullable()) {
            return false
        }
        i += 1
    }
    return true
}

private fn isString(type: TypeRef?) -> Boolean =
    type != null && (type.name().equals("String") || type.name().equals("java.lang.String"))

private fn nonNull(type: TypeRef?) -> TypeRef? =
    if (type == null) null else TypeRef(type.pos(), type.name(), type.args(), false)

private fn simple(name: String, pos: Pos) -> TypeRef = TypeRef(pos, name, ArrayList<TypeRef>(), false)

/** `attempt X else Y` is a `Result<T, E>` when the types of `X` and `Y` are known. */
private fn resultOf(value: TypeRef?, error: TypeRef?, pos: Pos) -> TypeRef? {
    if (value == null || error == null) {
        return null
    }
    return TypeRef(pos, "Result", List.of(value, error), false)
}

/** `attempt X else e -> throw Y` has the type of `X`. */
private fn throwsInstead(a: Expr.Attempt) -> Boolean = isThrow(a.handler())

private fn isThrow(e: Expr) -> Boolean = e is Expr.Throw || (e is Expr.Paren && isThrow(e.inner()))
