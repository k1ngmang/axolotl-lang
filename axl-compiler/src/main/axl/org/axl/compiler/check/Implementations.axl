package org.axl.compiler.check

import java.util.ArrayList
import java.util.HashMap
import java.util.HashSet
import java.util.List
import java.util.Map
import java.util.Set
import org.axl.compiler.JavaClasses
import org.axl.compiler.ast.Decl
import org.axl.compiler.ast.Expr
import org.axl.compiler.ast.Import
import org.axl.compiler.ast.Pos
import org.axl.compiler.ast.SourceFile
import org.axl.compiler.ast.TypeRef

/*
 * A data class or class that implements an interface of its file or of another file of its package
 * gives each value and each method the interface requires. Java checks that a method exists, but not the nullness of its types: a
 * `String?` field would let the interface return null where it promises a `String`.
 */

data class Mismatch(val pos: Pos, val message: String)

/** A value a type gives, with where it is declared. */
data class Given(val pos: Pos, val type: TypeRef?)

/** An interface a type implements, with the types it writes for the interface's type parameters. */
data class Implemented(val iface: Decl.Interface, val args: List<TypeRef>)

/** A method of an interface the type implements, or of the type itself when from is null. */
data class Inherited(val method: Decl.Function, val from: Implemented?)

fn check(file: SourceFile, siblings: List<SourceFile>) -> List<Mismatch> {
    val problems = ArrayList<Mismatch>()
    for (decl in file.decls()) {
        if (decl is Decl.DataClass) {
            implementer(file, siblings, decl, fieldsOf(decl.fields()), decl.supertypes(), problems)
        } else if (decl is Decl.ClassDecl) {
            implementer(file, siblings, decl, propertiesOf(decl), decl.supertypes(), problems)
        } else if (decl is Decl.EnumDecl) {
            implementer(file, siblings, decl, withMethods(fieldsOf(decl.fields()), decl.methods()), decl.supertypes(), problems)
        }
    }
    return problems
}

private fn implementer(file: SourceFile, siblings: List<SourceFile>, decl: Decl, given: Map<String, Given>,
                       supertypes: List<TypeRef>, problems: List<Mismatch>) {
    val seen = HashSet<String>()
    val all = interfaces(file, siblings, supertypes, HashSet<String>())
    val inherited = ArrayList<Inherited>()
    for (i in all) {
        for (method in i.iface().methods()) {
            if (!method.isPrivate()) {
                inherited.add(Inherited(method, i))
            }
        }
    }
    for (implemented in all) {
        val iface = implemented.iface()
        for (member in iface.members()) {
            // The parser requires the type of a member, so it is never missing here.
            val required = substitute(member.type()!!, iface.typeParams(), implemented.args())
            val field = given.get(member.name())
            if (!seen.add(member.name() + "/")) {
                // Reported where the interface declares it twice.
            } else if (field == null) {
                problems.add(Mismatch(decl.namePos(), "`" + decl.name() + "` does not give `val " + member.name() + ": " +
                    text(required) + "`, which the interface `" + iface.name() + "` requires; add it to its " +
                    (if (decl is Decl.EnumDecl) "fields" else "parameters")))
            } else {
                compare(member.name(), field, required, iface, problems)
            }
        }
        for (method in iface.methods()) {
            val key = method.name() + "/" + String.join(",", parameterTypes(Inherited(method, implemented)))
            if (method.isPrivate() || !seen.add(key)) {
                // Reported where the interface declares it twice; a private method belongs to the interface alone.
            } else {
                // A default method gives what another interface requires, as in Java.
                val hasDefault = inherited |> anyMatch { d -> hasBody(d.method()) && d.method().name().equals(method.name()) &&
                    sameParameters(d, Inherited(method, implemented)) }
                implementation(decl, methodsOf(decl), method, implemented, inherited, hasDefault, problems)
            }
        }
    }
}

/**
 * A type that implements a sealed interface of another package of the build: Java lets only the types of the
 * interface's package implement it.
 */
fn foreignSealed(file: SourceFile, siblings: List<SourceFile>) -> List<Mismatch> {
    val problems = ArrayList<Mismatch>()
    for (decl in file.decls()) {
        for (type in supertypesOf(decl)) {
            val qualified = qualifiedName(file, type.name())
            for (sibling in siblings) {
                for (other in sibling.decls()) {
                    if (qualified != null && other is Decl.Interface && other.isSealed() && !samePackage(file, sibling) &&
                        qualified.equals(javaName(sibling, other))) {
                        problems.add(Mismatch(type.pos(), "`" + other.name() + "` is sealed, so only the types of its package `" +
                            sibling.packageName() + "` can implement it; move `" + decl.name() + "` there, or implement an interface " +
                            "that is not sealed"))
                    }
                }
            }
        }
    }
    return problems
}

private fn supertypesOf(decl: Decl) -> List<TypeRef> = when (decl) {
    is Decl.DataClass -> decl.supertypes()
    is Decl.ClassDecl -> decl.supertypes()
    is Decl.Interface -> decl.supertypes()
    is Decl.EnumDecl -> decl.supertypes()
    else -> List.of()
}

/** The name with its package, as written or as an import gives it; null for a name of the file's own package. */
private fn qualifiedName(file: SourceFile, name: String) -> String? {
    if (name.contains(".")) {
        return name
    }
    for (imp in file.imports()) {
        if (imp.kind() == Import.Kind.TYPE && imp.simpleName().equals(name)) {
            return imp.name()
        }
    }
    return null
}

/** `app.Shape` for the type of the file `Shape.axl`, `app.Shapes.Shape` for one nested in the class of `Shapes.axl`. */
private fn javaName(file: SourceFile, decl: Decl) -> String {
    val pkg = file.packageName()
    val prefix = if (pkg == null) "" else pkg + "."
    return if (decl.name().equals(file.className())) prefix + decl.name() else prefix + file.className() + "." + decl.name()
}

private fn methodsOf(decl: Decl) -> List<Decl.Function> = when (decl) {
    is Decl.ClassDecl -> decl.methods()
    is Decl.DataClass -> decl.methods()
    is Decl.EnumDecl -> decl.methods()
    else -> List.of()
}

/**
 * A class or data class gives a method with the name, as many parameters, and types that fit the interface's; it
 * inherits one that has a default, or overrides it by the same rules. A method of the name whose parameter types
 * Java tells apart is an overload when another method implements the interface's, or implements another method of
 * the interfaces; otherwise it is taken as the implementation, with the wrong types.
 */
private fn implementation(c: Decl, methods: List<Decl.Function>, method: Decl.Function, implemented: Implemented,
                          interfaceMethods: List<Inherited>, hasDefault: Boolean, problems: List<Mismatch>) {
    val iface = implemented.iface()
    val named = methods |> filter { m -> m.name().equals(method.name()) && m.params().size() == method.params().size() }
    val matching = named |> filter { m -> sameParameters(Inherited(m, null), Inherited(method, implemented)) } |> first
    val own = if (matching != null) matching else named |> filter { m -> interfaceMethods |> noneMatch { i ->
        i.method().name().equals(m.name()) && sameParameters(Inherited(m, null), i) } } |> first
    val declaredReturn = method.returnType()
    val required: TypeRef? = if (declaredReturn == null) null else substitute(declaredReturn, iface.typeParams(), implemented.args())
    val property = if (own == null && method.params().isEmpty()) propertyNamed(c, method.name()) else null
    if (own == null && property != null && c is Decl.DataClass) {
        // The accessor Java gives the field of a record is that method.
        val type = property.type()
        if (required == null || (type != null && !fits(type, required))) {
            problems.add(Mismatch(property.pos(), "`" + property.name() + "` is `" + returnText(type) + "` here, but the interface `" +
                iface.name() + "` requires `" + signature(method) + "`"))
        }
        return
    }
    if (own == null && hasDefault) {
        return
    }
    if (own == null) {
        val where = if (c is Decl.DataClass) "add it in a body after the fields: `data class " + c.name() + "(...) : " + iface.name() + " { fn ... }`"
            else if (property != null && required != null) "its property `" + property.name() + "` is a field, which gives no method; " +
                "write the interface's member as `val " + property.name() + ": " + text(required) + "`, which the property gives"
            else "add the method"
        problems.add(Mismatch(c.namePos(), "`" + c.name() + "` does not give `" + signature(method) + "`, which the interface `" +
            iface.name() + "` requires; " + where))
        return
    }
    if (own.isPrivate()) {
        val does = if (hasBody(method)) "overrides" else "implements"
        problems.add(Mismatch(own.namePos(), "`" + own.name() + "` " + does + " a method of the interface `" + iface.name() +
            "`, so it cannot be private"))
    }
    val givenReturn = own.returnType()
    if ((required == null && givenReturn != null) || (required != null && (givenReturn == null || !fits(givenReturn, required)))) {
        problems.add(Mismatch(own.namePos(), "`" + own.name() + "` returns `" + returnText(givenReturn) + "` here, but the interface `" +
            iface.name() + "` requires `" + signature(method) + "`"))
    }
    var i = 0
    while (i < own.params().size()) {
        val givenParam = own.params().get(i).type()
        val declaredParam = method.params().get(i).type()
        val requiredParam: TypeRef? = if (declaredParam == null) null else substitute(declaredParam, iface.typeParams(), implemented.args())
        // A parameter may accept more than required, `String?` for `String`, but not less.
        if (givenParam != null && requiredParam != null && !fits(requiredParam, givenParam)) {
            problems.add(Mismatch(own.params().get(i).pos(), "the parameter `" + own.params().get(i).name() + "` is `" +
                text(givenParam) + "` here, but the interface `" + iface.name() + "` requires `" + signature(method) + "`"))
        }
        i += 1
    }
}

/** The field of a data class or an enum, or the parameter or property of a class, of that name. */
private fn propertyNamed(c: Decl, name: String) -> Expr.Param? = when (c) {
    is Decl.DataClass -> c.fields() |> filter { f -> f.name().equals(name) } |> first
    is Decl.EnumDecl -> c.fields() |> filter { f -> f.name().equals(name) } |> first
    is Decl.ClassDecl -> {
        val all = ArrayList<Decl.Property>(c.parameters())
        all.addAll(c.properties())
        val found = all |> filter { p -> p.name().equals(name) } |> first
        if (found == null) null else Expr.Param(found.namePos(), found.name(), found.type(), List.of())
    }
    else -> null
}

private fn signature(method: Decl.Function) -> String {
    val params = method.params() |> map { p -> p.name() + ": " + text(p.type()!!) }
    val returnType = method.returnType()
    return "fn " + method.name() + "(" + String.join(", ", params) + ")" + (if (returnType == null) "" else " -> " + text(returnType))
}

private fn returnText(type: TypeRef?) -> String = if (type == null) "nothing" else text(type)

private fn compare(name: String, field: Given, required: TypeRef, iface: Decl.Interface, problems: List<Mismatch>) {
    val type = field.type()
    if (type != null && !fits(type, required)) {
        problems.add(Mismatch(field.pos(), "`" + name + "` is `" + text(type) + "` here, but the interface `" +
            iface.name() + "` requires `val " + name + ": " + text(required) + "`"))
    }
}

/** The values the interfaces of the build among the supertypes require. */
fn requiredValues(file: SourceFile, siblings: List<SourceFile>, supertypes: List<TypeRef>) -> List<Expr.Param> {
    val values = ArrayList<Expr.Param>()
    for (implemented in interfaces(file, siblings, supertypes, HashSet<String>())) {
        values.addAll(implemented.iface().members())
    }
    return values
}

/** `T` of `interface Repository<T>` is `User` in `class Users : Repository<User>`. */
fn substitute(type: TypeRef, params: List<Decl.TypeParam>, args: List<TypeRef>) -> TypeRef {
    if (params.isEmpty() || params.size() != args.size()) {
        return type
    }
    var i = 0
    while (i < params.size()) {
        if (params.get(i).name().equals(type.name()) && type.args().isEmpty()) {
            val arg = args.get(i)
            return TypeRef(type.pos(), arg.name(), arg.args(), arg.nullable() || type.nullable())
        }
        i += 1
    }
    val substituted = type.args() |> map { a -> substitute(a, params, args) }
    return TypeRef(type.pos(), type.name(), substituted, type.nullable())
}

/**
 * A method an interface requires, with where it has a type variable, which Java boxes an `Int` for; method is null for
 * one of a Java interface.
 */
data class RequiredMethod(val name: String, val boxedParams: List<Boolean>, val boxedResult: Boolean, val method: Inherited?)

/** Whether the method of a class is the one required: the name, as many parameters, and the same types where known. */
fn isRequired(r: RequiredMethod, f: Decl.Function) -> Boolean {
    val method = r.method()
    return r.name().equals(f.name()) && r.boxedParams().size() == f.params().size() &&
        (method == null || sameParameters(Inherited(f, null), method))
}

/** The methods the interfaces among the supertypes require: those of the build and those of Java classes that can be read. */
fn requiredMethods(file: SourceFile, siblings: List<SourceFile>, classes: JavaClasses, supertypes: List<TypeRef>) -> List<RequiredMethod> {
    val result = ArrayList<RequiredMethod>()
    for (implemented in interfaces(file, siblings, supertypes, HashSet<String>())) {
        val iface = implemented.iface()
        val names = iface.typeParams() |> map { p -> p.name() }
        for (member in iface.members()) {
            result.add(RequiredMethod(member.name(), List.of(), isTypeVariable(names, member.type()), null))
        }
        for (method in iface.methods()) {
            if (!method.isPrivate()) {
                val params = method.params() |> map { p -> isTypeVariable(names, p.type()) }
                result.add(RequiredMethod(method.name(), params, isTypeVariable(names, method.returnType()), Inherited(method, implemented)))
            }
        }
    }
    for (type in supertypes) {
        // Only generic ones: a type argument is where Java boxes.
        if (!type.args().isEmpty() && interfaceNamed(file, siblings, type.name()) == null) {
            val library = Libraries.classNamed(file, classes, type.name())
            if (library != null) {
                for (shape in classes.methods(library.name())) {
                    result.add(RequiredMethod(shape.name(), shape.typeVariables(), shape.typeVariable(), null))
                }
            }
        }
    }
    return result
}

private fn isTypeVariable(names: List<String>, type: TypeRef?) -> Boolean =
    type != null && type.args().isEmpty() && names.contains(type.name())

/**
 * The fields of a data class that give a method whose result is a type variable, `val key: Int` for `fn key() -> K`
 * of `Keyed<Int>`. A record's accessor returns the type of its field and Java allows no second `key()`, so the
 * field is an `Integer` in Java.
 */
fn boxedFields(file: SourceFile, siblings: List<SourceFile>, classes: JavaClasses, dataClass: Decl.DataClass) -> Set<String> {
    val result = HashSet<String>()
    val required = requiredMethods(file, siblings, classes, dataClass.supertypes())
    for (field in dataClass.fields()) {
        val type = field.type()
        val boxes = required |> anyMatch { r -> r.name().equals(field.name()) && r.boxedParams().isEmpty() && r.boxedResult() }
        if (boxes && type != null && !type.nullable() && type.args().isEmpty() && PRIMITIVES.contains(type.name())) {
            result.add(field.name())
        }
    }
    return result
}

private val PRIMITIVES: Set<String> = Set.of("Int", "Long", "Boolean", "Float", "Double")

/**
 * Whether Java gives the box of the result of the method of a type of the build: one that implements a method
 * whose result is a type variable, `e.key()` on `data class Entry(val key: Int) : Keyed<Int>`, or one an interface
 * declares so, `k.key()` on a `Keyed<Int>`.
 */
fn boxedResult(file: SourceFile, siblings: List<SourceFile>, classes: JavaClasses, type: TypeRef, method: String, arity: Int) -> Boolean {
    val found = typeNamed(file, siblings, type.name())
    if (found == null) {
        return false
    }
    val decl = found.decl()
    val supertypes = if (decl is Decl.Interface) List.of(type) else supertypesOf(decl)
    return requiredMethods(found.file(), siblings, classes, supertypes) |>
        anyMatch { r -> r.name().equals(method) && r.boxedParams().size() == arity && r.boxedResult() }
}

/** A declaration with the file that declares it. */
data class Located(val file: SourceFile, val decl: Decl)

/** The data class, class or interface of the build a type name means in the file: its own, its package's or an imported one. */
private fn typeNamed(file: SourceFile, siblings: List<SourceFile>, name: String) -> Located? {
    val qualified = qualifiedName(file, name)
    if (qualified == null) {
        for (decl in file.decls()) {
            if (isImplementer(decl) && decl.name().equals(name)) {
                return Located(file, decl)
            }
        }
    }
    for (sibling in siblings) {
        for (decl in sibling.decls()) {
            if (isImplementer(decl) && (if (qualified == null) samePackage(file, sibling) && decl.name().equals(name)
                    else qualified.equals(javaName(sibling, decl)))) {
                return Located(sibling, decl)
            }
        }
    }
    return null
}

private fn isImplementer(decl: Decl) -> Boolean = decl is Decl.DataClass || decl is Decl.ClassDecl || decl is Decl.Interface

/** A method of an interface with a body is a default method; one without is required of each implementation. */
fn hasBody(f: Decl.Function) -> Boolean = f.exprBody() != null || f.body() != null

/**
 * The supertypes, among those written, through which a type inherits a default method of the build with the name and
 * as many parameters: `super.add(x)` calls it as Java's `Notes.super.add(x)`.
 */
fn defaultsThrough(file: SourceFile, siblings: List<SourceFile>, supertypes: List<TypeRef>, name: String, arity: Int) -> List<TypeRef> {
    val result = ArrayList<TypeRef>()
    for (type in supertypes) {
        val reached = interfaces(file, siblings, List.of(type), HashSet<String>())
        val found = reached |> anyMatch { i -> i.iface().methods() |> anyMatch { m -> hasBody(m) && !m.isPrivate() &&
            m.name().equals(name) && m.params().size() == arity } }
        if (found) {
            result.add(type)
        }
    }
    return result
}

/** What the interfaces require or give: the values, which are methods without parameters, and the methods. */
data class Overridable(val values: Set<String>, val methods: List<Inherited>)

fn overridable(file: SourceFile, siblings: List<SourceFile>, supertypes: List<TypeRef>) -> Overridable {
    val values = HashSet<String>()
    val methods = ArrayList<Inherited>()
    for (implemented in interfaces(file, siblings, supertypes, HashSet<String>())) {
        val iface = implemented.iface()
        for (member in iface.members()) {
            values.add(member.name())
        }
        for (method in iface.methods()) {
            if (!method.isPrivate()) {
                methods.add(Inherited(method, implemented))
            }
        }
    }
    return Overridable(values, methods)
}

/** Whether the method implements or overrides one of the interfaces, so that Java gets `@Override`. */
fn overrides(f: Decl.Function, overridable: Overridable) -> Boolean =
    (f.params().isEmpty() && overridable.values().contains(f.name())) ||
        (overridable.methods() |> anyMatch { m -> m.method().name().equals(f.name()) && sameParameters(Inherited(f, null), m) })

/**
 * Whether two methods take parameters Java does not tell apart: the same types once `?` and type arguments are left
 * out, with `Int?` as `Integer`, a type parameter of the method as its bound, and a type variable of an interface as the
 * type argument the implementing type writes, which Java boxes, so that `Int` there is `Integer` on both sides.
 */
fn sameParameters(a: Inherited, b: Inherited) -> Boolean {
    if (a.method().params().size() != b.method().params().size()) {
        return false
    }
    val aVariables = typeVariables(a)
    val bVariables = typeVariables(b)
    var i = 0
    while (i < a.method().params().size()) {
        val boxed = aVariables.get(i) || bVariables.get(i)
        if (!erasedParameter(a, i, boxed).equals(erasedParameter(b, i, boxed))) {
            return false
        }
        i += 1
    }
    return true
}

/** The parameter types as Java tells methods apart, see sameParameters, with a type variable of the interface boxed. */
fn parameterTypes(m: Inherited) -> List<String> {
    val variables = typeVariables(m)
    val result = ArrayList<String>()
    var i = 0
    while (i < m.method().params().size()) {
        result.add(erasedParameter(m, i, variables.get(i)))
        i += 1
    }
    return result
}

/** For each parameter, whether its type is a type variable of the interface. */
private fn typeVariables(m: Inherited) -> List<Boolean> {
    val from = m.from()
    val names: List<String> = if (from == null) List.of() else from.iface().typeParams() |> map { p -> p.name() }
    return m.method().params() |> map { p -> isTypeVariable(names, p.type()) }
}

private fn erasedParameter(m: Inherited, index: Int, boxed: Boolean) -> String {
    val type = m.method().params().get(index).type()
    if (type == null) {
        return "?"
    }
    val from = m.from()
    val seen = if (from == null) type else substitute(type, from.iface().typeParams(), from.args())
    return erasedName(seen, m.method().typeParams(), boxed)
}

/** `Int` is `int` and `Int?` `Integer`, a type parameter its bound or `Object`, a class its simple name. */
fn erasedName(type: TypeRef, typeParams: List<Decl.TypeParam>, boxed: Boolean) -> String {
    for (p in typeParams) {
        if (p.name().equals(type.name()) && type.args().isEmpty()) {
            val bound = p.bound()
            return if (bound == null) "Object" else erasedName(bound, List.of(), false)
        }
    }
    val simple = type.name().substring(type.name().lastIndexOf(".") + 1)
    val name = if (simple.equals("Integer")) "Int" else simple
    return if (PRIMITIVES.contains(name) && (boxed || type.nullable() || !simple.equals(name))) "java.lang." + name else name
}

/**
 * The interfaces among the supertypes declared in the file or in another file of the build in the
 * same package, with the interfaces they extend and the type arguments each gets.
 */
private fn interfaces(file: SourceFile, siblings: List<SourceFile>, supertypes: List<TypeRef>, seen: Set<String>) -> List<Implemented> {
    val result = ArrayList<Implemented>()
    for (type in supertypes) {
        val decl = interfaceNamed(file, siblings, type.name())
        if (decl != null && seen.add(decl.name())) {
            result.add(Implemented(decl, type.args()))
            // `interface A<T> : B<List<T>>` passes its own arguments on to B.
            val parents = decl.supertypes() |> map { p -> substitute(p, decl.typeParams(), type.args()) }
            result.addAll(interfaces(file, siblings, parents, seen))
        }
    }
    return result
}

private fn interfaceNamed(file: SourceFile, siblings: List<SourceFile>, name: String) -> Decl.Interface? {
    for (decl in file.decls()) {
        if (decl is Decl.Interface && decl.name().equals(name)) {
            return decl
        }
    }
    var found: Decl.Interface? = null
    for (sibling in siblings) {
        for (decl in sibling.decls()) {
            if (decl is Decl.Interface && decl.name().equals(name) && samePackage(file, sibling)) {
                if (found != null) {
                    return null
                }
                found = decl
            }
        }
    }
    return found
}

private fn samePackage(file: SourceFile, other: SourceFile) -> Boolean {
    val own = file.packageName()
    val theirs = other.packageName()
    return if (own == null) theirs == null else own.equals(theirs)
}

/** A value may be narrower than required, `String` for `String?`, but its type arguments must match. */
private fn fits(given: TypeRef, required: TypeRef) -> Boolean {
    if (given.nullable() && !required.nullable()) {
        return false
    }
    return given.name().equals(required.name()) && sameArgs(given.args(), required.args())
}

private fn sameArgs(given: List<TypeRef>, required: List<TypeRef>) -> Boolean {
    if (given.size() != required.size()) {
        return false
    }
    var i = 0
    while (i < given.size()) {
        val a = given.get(i)
        val b = required.get(i)
        if (a.nullable() != b.nullable() || !a.name().equals(b.name()) || !sameArgs(a.args(), b.args())) {
            return false
        }
        i += 1
    }
    return true
}

private fn fieldsOf(fields: List<Expr.Param>) -> Map<String, Given> {
    val given = HashMap<String, Given>()
    for (f in fields) {
        given.put(f.name(), Given(f.pos(), f.type()))
    }
    return given
}

private fn propertiesOf(c: Decl.ClassDecl) -> Map<String, Given> {
    val given = HashMap<String, Given>()
    for (p in c.parameters()) {
        given.put(p.name(), Given(p.namePos(), p.type()))
    }
    for (p in c.properties()) {
        given.put(p.name(), Given(p.namePos(), p.type()))
    }
    return withMethods(given, c.methods())
}

/** A method without parameters gives the value as well. */
private fn withMethods(given: Map<String, Given>, methods: List<Decl.Function>) -> Map<String, Given> {
    for (m in methods) {
        if (m.params().isEmpty()) {
            given.put(m.name(), Given(m.namePos(), m.returnType()))
        }
    }
    return given
}

private fn text(type: TypeRef) -> String {
    val args = type.args() |> map { a -> text(a) }
    val written = if (args.isEmpty()) type.name() else type.name() + "<" + String.join(", ", args) + ">"
    return if (type.nullable()) written + "?" else written
}
