package org.axl.compiler.check

import java.util.ArrayList
import java.util.HashMap
import java.util.HashSet
import java.util.List
import java.util.Map
import java.util.Set
import org.axl.compiler.JavaClasses
import org.axl.compiler.ast.Decl
import org.axl.compiler.ast.Expr
import org.axl.compiler.ast.Import
import org.axl.compiler.ast.Pos
import org.axl.compiler.ast.SourceFile
import org.axl.compiler.ast.TypeRef

/*
 * A data class or class that implements an interface of its file or of another file of its package
 * gives each value and each method the interface requires. Java checks that a method exists, but not the nullness of its types: a
 * `String?` field would let the interface return null where it promises a `String`.
 */

data class Mismatch(val pos: Pos, val message: String)

/** A value a type gives, with where it is declared. */
data class Given(val pos: Pos, val type: TypeRef?)

/** An interface a type implements, with the types it writes for the interface's type parameters. */
data class Implemented(val iface: Decl.Interface, val args: List<TypeRef>)

fn check(file: SourceFile, siblings: List<SourceFile>) -> List<Mismatch> {
    val problems = ArrayList<Mismatch>()
    for (decl in file.decls()) {
        if (decl is Decl.DataClass) {
            implementer(file, siblings, decl, fieldsOf(decl.fields()), decl.supertypes(), problems)
        } else if (decl is Decl.ClassDecl) {
            implementer(file, siblings, decl, propertiesOf(decl), decl.supertypes(), problems)
        }
    }
    return problems
}

private fn implementer(file: SourceFile, siblings: List<SourceFile>, decl: Decl, given: Map<String, Given>,
                       supertypes: List<TypeRef>, problems: List<Mismatch>) {
    val seen = HashSet<String>()
    for (implemented in interfaces(file, siblings, supertypes, HashSet<String>())) {
        val iface = implemented.iface()
        for (member in iface.members()) {
            // The parser requires the type of a member, so it is never missing here.
            val required = substitute(member.type()!!, iface.typeParams(), implemented.args())
            val field = given.get(member.name())
            if (!seen.add(member.name() + "/0")) {
                // Reported where the interface declares it twice.
            } else if (field == null) {
                problems.add(Mismatch(decl.namePos(), "`" + decl.name() + "` does not give `val " + member.name() + ": " +
                    text(required) + "`, which the interface `" + iface.name() + "` requires; add it to its parameters"))
            } else {
                compare(member.name(), field, required, iface, problems)
            }
        }
        for (method in iface.methods()) {
            if (!seen.add(method.name() + "/" + method.params().size())) {
                // Reported where the interface declares it twice.
            } else {
                implementation(decl, methodsOf(decl), method, implemented, problems)
            }
        }
    }
}

/**
 * A type that implements a sealed interface of another package of the build: Java lets only the types of the
 * interface's package implement it.
 */
fn foreignSealed(file: SourceFile, siblings: List<SourceFile>) -> List<Mismatch> {
    val problems = ArrayList<Mismatch>()
    for (decl in file.decls()) {
        for (type in supertypesOf(decl)) {
            val qualified = qualifiedName(file, type.name())
            for (sibling in siblings) {
                for (other in sibling.decls()) {
                    if (qualified != null && other is Decl.Interface && other.isSealed() && !samePackage(file, sibling) &&
                        qualified.equals(javaName(sibling, other))) {
                        problems.add(Mismatch(type.pos(), "`" + other.name() + "` is sealed, so only the types of its package `" +
                            sibling.packageName() + "` can implement it; move `" + decl.name() + "` there, or implement an interface " +
                            "that is not sealed"))
                    }
                }
            }
        }
    }
    return problems
}

private fn supertypesOf(decl: Decl) -> List<TypeRef> = when (decl) {
    is Decl.DataClass -> decl.supertypes()
    is Decl.ClassDecl -> decl.supertypes()
    is Decl.Interface -> decl.supertypes()
    else -> List.of()
}

/** The name with its package, as written or as an import gives it; null for a name of the file's own package. */
private fn qualifiedName(file: SourceFile, name: String) -> String? {
    if (name.contains(".")) {
        return name
    }
    for (imp in file.imports()) {
        if (imp.kind() == Import.Kind.TYPE && imp.simpleName().equals(name)) {
            return imp.name()
        }
    }
    return null
}

/** `app.Shape` for the type of the file `Shape.axl`, `app.Shapes.Shape` for one nested in the class of `Shapes.axl`. */
private fn javaName(file: SourceFile, decl: Decl) -> String {
    val pkg = file.packageName()
    val prefix = if (pkg == null) "" else pkg + "."
    return if (decl.name().equals(file.className())) prefix + decl.name() else prefix + file.className() + "." + decl.name()
}

private fn methodsOf(decl: Decl) -> List<Decl.Function> = when (decl) {
    is Decl.ClassDecl -> decl.methods()
    is Decl.DataClass -> decl.methods()
    else -> List.of()
}

/** A class or data class gives a method with the name, as many parameters, and types that fit the interface's. */
private fn implementation(c: Decl, methods: List<Decl.Function>, method: Decl.Function, implemented: Implemented,
                          problems: List<Mismatch>) {
    val iface = implemented.iface()
    val own = methods |> filter { m -> m.name().equals(method.name()) && m.params().size() == method.params().size() } |> first
    if (own == null) {
        val where = if (c is Decl.DataClass) "add it in a body after the fields: `data class " + c.name() + "(...) : " + iface.name() + " { fn ... }`"
            else "add the method"
        problems.add(Mismatch(c.namePos(), "`" + c.name() + "` does not give `" + signature(method) + "`, which the interface `" +
            iface.name() + "` requires; " + where))
        return
    }
    if (own.isPrivate()) {
        problems.add(Mismatch(own.namePos(), "`" + own.name() + "` implements a method of the interface `" + iface.name() +
            "`, so it cannot be private"))
    }
    val declaredReturn = method.returnType()
    val required: TypeRef? = if (declaredReturn == null) null else substitute(declaredReturn, iface.typeParams(), implemented.args())
    val givenReturn = own.returnType()
    if ((required == null && givenReturn != null) || (required != null && (givenReturn == null || !fits(givenReturn, required)))) {
        problems.add(Mismatch(own.namePos(), "`" + own.name() + "` returns `" + returnText(givenReturn) + "` here, but the interface `" +
            iface.name() + "` requires `" + signature(method) + "`"))
    }
    var i = 0
    while (i < own.params().size()) {
        val givenParam = own.params().get(i).type()
        val declaredParam = method.params().get(i).type()
        val requiredParam: TypeRef? = if (declaredParam == null) null else substitute(declaredParam, iface.typeParams(), implemented.args())
        // A parameter may accept more than required, `String?` for `String`, but not less.
        if (givenParam != null && requiredParam != null && !fits(requiredParam, givenParam)) {
            problems.add(Mismatch(own.params().get(i).pos(), "the parameter `" + own.params().get(i).name() + "` is `" +
                text(givenParam) + "` here, but the interface `" + iface.name() + "` requires `" + signature(method) + "`"))
        }
        i += 1
    }
}

private fn signature(method: Decl.Function) -> String {
    val params = method.params() |> map { p -> p.name() + ": " + text(p.type()!!) }
    val returnType = method.returnType()
    return "fn " + method.name() + "(" + String.join(", ", params) + ")" + (if (returnType == null) "" else " -> " + text(returnType))
}

private fn returnText(type: TypeRef?) -> String = if (type == null) "nothing" else text(type)

private fn compare(name: String, field: Given, required: TypeRef, iface: Decl.Interface, problems: List<Mismatch>) {
    val type = field.type()
    if (type != null && !fits(type, required)) {
        problems.add(Mismatch(field.pos(), "`" + name + "` is `" + text(type) + "` here, but the interface `" +
            iface.name() + "` requires `val " + name + ": " + text(required) + "`"))
    }
}

/** The values the interfaces of the build among the supertypes require. */
fn requiredValues(file: SourceFile, siblings: List<SourceFile>, supertypes: List<TypeRef>) -> List<Expr.Param> {
    val values = ArrayList<Expr.Param>()
    for (implemented in interfaces(file, siblings, supertypes, HashSet<String>())) {
        values.addAll(implemented.iface().members())
    }
    return values
}

/** `T` of `interface Repository<T>` is `User` in `class Users : Repository<User>`. */
fn substitute(type: TypeRef, params: List<Decl.TypeParam>, args: List<TypeRef>) -> TypeRef {
    if (params.isEmpty() || params.size() != args.size()) {
        return type
    }
    var i = 0
    while (i < params.size()) {
        if (params.get(i).name().equals(type.name()) && type.args().isEmpty()) {
            val arg = args.get(i)
            return TypeRef(type.pos(), arg.name(), arg.args(), arg.nullable() || type.nullable())
        }
        i += 1
    }
    val substituted = type.args() |> map { a -> substitute(a, params, args) }
    return TypeRef(type.pos(), type.name(), substituted, type.nullable())
}

/** A method an interface requires, with where it has a type variable, which Java boxes an `Int` for. */
data class RequiredMethod(val name: String, val boxedParams: List<Boolean>, val boxedResult: Boolean)

/** The methods the interfaces among the supertypes require: those of the build and those of Java classes that can be read. */
fn requiredMethods(file: SourceFile, siblings: List<SourceFile>, classes: JavaClasses, supertypes: List<TypeRef>) -> List<RequiredMethod> {
    val result = ArrayList<RequiredMethod>()
    for (implemented in interfaces(file, siblings, supertypes, HashSet<String>())) {
        val iface = implemented.iface()
        val names = iface.typeParams() |> map { p -> p.name() }
        for (method in iface.methods()) {
            val params = method.params() |> map { p -> isTypeVariable(names, p.type()) }
            result.add(RequiredMethod(method.name(), params, isTypeVariable(names, method.returnType())))
        }
    }
    for (type in supertypes) {
        // Only generic ones: a type argument is where Java boxes.
        if (!type.args().isEmpty() && interfaceNamed(file, siblings, type.name()) == null) {
            val library = Libraries.classNamed(file, classes, type.name())
            if (library != null) {
                for (shape in classes.methods(library.name())) {
                    result.add(RequiredMethod(shape.name(), shape.typeVariables(), shape.typeVariable()))
                }
            }
        }
    }
    return result
}

private fn isTypeVariable(names: List<String>, type: TypeRef?) -> Boolean =
    type != null && type.args().isEmpty() && names.contains(type.name())

/** What the interfaces require, as `name/arity`: a value is a method without parameters. */
fn required(file: SourceFile, siblings: List<SourceFile>, supertypes: List<TypeRef>) -> List<String> {
    val keys = ArrayList<String>()
    for (implemented in interfaces(file, siblings, supertypes, HashSet<String>())) {
        val iface = implemented.iface()
        for (member in iface.members()) {
            keys.add(member.name() + "/0")
        }
        for (method in iface.methods()) {
            keys.add(method.name() + "/" + method.params().size())
        }
    }
    return keys
}

/**
 * The interfaces among the supertypes declared in the file or in another file of the build in the
 * same package, with the interfaces they extend and the type arguments each gets.
 */
private fn interfaces(file: SourceFile, siblings: List<SourceFile>, supertypes: List<TypeRef>, seen: Set<String>) -> List<Implemented> {
    val result = ArrayList<Implemented>()
    for (type in supertypes) {
        val decl = interfaceNamed(file, siblings, type.name())
        if (decl != null && seen.add(decl.name())) {
            result.add(Implemented(decl, type.args()))
            // `interface A<T> : B<List<T>>` passes its own arguments on to B.
            val parents = decl.supertypes() |> map { p -> substitute(p, decl.typeParams(), type.args()) }
            result.addAll(interfaces(file, siblings, parents, seen))
        }
    }
    return result
}

private fn interfaceNamed(file: SourceFile, siblings: List<SourceFile>, name: String) -> Decl.Interface? {
    for (decl in file.decls()) {
        if (decl is Decl.Interface && decl.name().equals(name)) {
            return decl
        }
    }
    var found: Decl.Interface? = null
    for (sibling in siblings) {
        for (decl in sibling.decls()) {
            if (decl is Decl.Interface && decl.name().equals(name) && samePackage(file, sibling)) {
                if (found != null) {
                    return null
                }
                found = decl
            }
        }
    }
    return found
}

private fn samePackage(file: SourceFile, other: SourceFile) -> Boolean {
    val own = file.packageName()
    val theirs = other.packageName()
    return if (own == null) theirs == null else own.equals(theirs)
}

/** A value may be narrower than required, `String` for `String?`, but its type arguments must match. */
private fn fits(given: TypeRef, required: TypeRef) -> Boolean {
    if (given.nullable() && !required.nullable()) {
        return false
    }
    return given.name().equals(required.name()) && sameArgs(given.args(), required.args())
}

private fn sameArgs(given: List<TypeRef>, required: List<TypeRef>) -> Boolean {
    if (given.size() != required.size()) {
        return false
    }
    var i = 0
    while (i < given.size()) {
        val a = given.get(i)
        val b = required.get(i)
        if (a.nullable() != b.nullable() || !a.name().equals(b.name()) || !sameArgs(a.args(), b.args())) {
            return false
        }
        i += 1
    }
    return true
}

private fn fieldsOf(fields: List<Expr.Param>) -> Map<String, Given> {
    val given = HashMap<String, Given>()
    for (f in fields) {
        given.put(f.name(), Given(f.pos(), f.type()))
    }
    return given
}

private fn propertiesOf(c: Decl.ClassDecl) -> Map<String, Given> {
    val given = HashMap<String, Given>()
    for (p in c.parameters()) {
        given.put(p.name(), Given(p.namePos(), p.type()))
    }
    for (p in c.properties()) {
        given.put(p.name(), Given(p.namePos(), p.type()))
    }
    // A method without parameters gives the value as well.
    for (m in c.methods()) {
        if (m.params().isEmpty()) {
            given.put(m.name(), Given(m.namePos(), m.returnType()))
        }
    }
    return given
}

private fn text(type: TypeRef) -> String {
    val args = type.args() |> map { a -> text(a) }
    val written = if (args.isEmpty()) type.name() else type.name() + "<" + String.join(", ", args) + ">"
    return if (type.nullable()) written + "?" else written
}
