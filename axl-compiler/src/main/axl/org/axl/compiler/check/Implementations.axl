package org.axl.compiler.check

import java.util.ArrayList
import java.util.HashMap
import java.util.HashSet
import java.util.List
import java.util.Map
import java.util.Set
import org.axl.compiler.ast.Decl
import org.axl.compiler.ast.Expr
import org.axl.compiler.ast.Pos
import org.axl.compiler.ast.SourceFile
import org.axl.compiler.ast.TypeRef

/*
 * A data class or class that implements an interface of its file gives each value and each method
 * the interface requires. Java checks that a method exists, but not the nullness of its types: a
 * `String?` field would let the interface return null where it promises a `String`.
 */

data class Mismatch(val pos: Pos, val message: String)

/** A value a type gives, with where it is declared. */
data class Given(val pos: Pos, val type: TypeRef?)

/** An interface a type implements, with the types it writes for the interface's type parameters. */
data class Implemented(val iface: Decl.Interface, val args: List<TypeRef>)

fn check(file: SourceFile) -> List<Mismatch> {
    val problems = ArrayList<Mismatch>()
    for (decl in file.decls()) {
        if (decl is Decl.DataClass) {
            implementer(file, decl, fieldsOf(decl.fields()), decl.supertypes(), problems)
        } else if (decl is Decl.ClassDecl) {
            implementer(file, decl, propertiesOf(decl), decl.supertypes(), problems)
        }
    }
    return problems
}

private fn implementer(file: SourceFile, decl: Decl, given: Map<String, Given>, supertypes: List<TypeRef>,
                       problems: List<Mismatch>) {
    val seen = HashSet<String>()
    for (implemented in interfaces(file, supertypes, HashSet<String>())) {
        val iface = implemented.iface()
        for (member in iface.members()) {
            // The parser requires the type of a member, so it is never missing here.
            val required = substitute(member.type()!!, iface.typeParams(), implemented.args())
            val field = given.get(member.name())
            if (!seen.add(member.name() + "/0")) {
                // Reported where the interface declares it twice.
            } else if (field == null) {
                problems.add(Mismatch(decl.namePos(), "`" + decl.name() + "` does not give `val " + member.name() + ": " +
                    text(required) + "`, which the interface `" + iface.name() + "` requires; add it to its parameters"))
            } else {
                compare(member.name(), field, required, iface, problems)
            }
        }
        for (method in iface.methods()) {
            if (!seen.add(method.name() + "/" + method.params().size())) {
                // Reported where the interface declares it twice.
            } else if (decl is Decl.ClassDecl) {
                implementation(decl, method, implemented, problems)
            } else {
                problems.add(Mismatch(decl.namePos(), "`" + decl.name() + "` is a data class, so it has no methods, but the " +
                    "interface `" + iface.name() + "` requires `" + signature(method) + "`; make `" + decl.name() +
                    "` a class, or write `" + method.name() + "` as a function of the file that takes the `" + iface.name() + "`"))
            }
        }
    }
}

/** A class gives a method with the name, as many parameters, and types that fit the interface's. */
private fn implementation(c: Decl.ClassDecl, method: Decl.Function, implemented: Implemented, problems: List<Mismatch>) {
    val iface = implemented.iface()
    val own = c.methods() |> filter { m -> m.name().equals(method.name()) && m.params().size() == method.params().size() } |> first
    if (own == null) {
        problems.add(Mismatch(c.namePos(), "`" + c.name() + "` does not give `" + signature(method) + "`, which the interface `" +
            iface.name() + "` requires; add the method"))
        return
    }
    if (own.isPrivate()) {
        problems.add(Mismatch(own.namePos(), "`" + own.name() + "` implements a method of the interface `" + iface.name() +
            "`, so it cannot be private"))
    }
    val declaredReturn = method.returnType()
    val required: TypeRef? = if (declaredReturn == null) null else substitute(declaredReturn, iface.typeParams(), implemented.args())
    val givenReturn = own.returnType()
    if ((required == null && givenReturn != null) || (required != null && (givenReturn == null || !fits(givenReturn, required)))) {
        problems.add(Mismatch(own.namePos(), "`" + own.name() + "` returns `" + returnText(givenReturn) + "` here, but the interface `" +
            iface.name() + "` requires `" + signature(method) + "`"))
    }
    var i = 0
    while (i < own.params().size()) {
        val givenParam = own.params().get(i).type()
        val declaredParam = method.params().get(i).type()
        val requiredParam: TypeRef? = if (declaredParam == null) null else substitute(declaredParam, iface.typeParams(), implemented.args())
        // A parameter may accept more than required, `String?` for `String`, but not less.
        if (givenParam != null && requiredParam != null && !fits(requiredParam, givenParam)) {
            problems.add(Mismatch(own.params().get(i).pos(), "the parameter `" + own.params().get(i).name() + "` is `" +
                text(givenParam) + "` here, but the interface `" + iface.name() + "` requires `" + signature(method) + "`"))
        }
        i += 1
    }
}

private fn signature(method: Decl.Function) -> String {
    val params = method.params() |> map { p -> p.name() + ": " + text(p.type()!!) }
    val returnType = method.returnType()
    return "fn " + method.name() + "(" + String.join(", ", params) + ")" + (if (returnType == null) "" else " -> " + text(returnType))
}

private fn returnText(type: TypeRef?) -> String = if (type == null) "nothing" else text(type)

private fn compare(name: String, field: Given, required: TypeRef, iface: Decl.Interface, problems: List<Mismatch>) {
    val type = field.type()
    if (type != null && !fits(type, required)) {
        problems.add(Mismatch(field.pos(), "`" + name + "` is `" + text(type) + "` here, but the interface `" +
            iface.name() + "` requires `val " + name + ": " + text(required) + "`"))
    }
}

/** The values the interfaces of the file among the supertypes require. */
fn requiredValues(file: SourceFile, supertypes: List<TypeRef>) -> List<Expr.Param> {
    val values = ArrayList<Expr.Param>()
    for (implemented in interfaces(file, supertypes, HashSet<String>())) {
        values.addAll(implemented.iface().members())
    }
    return values
}

/** `T` of `interface Repository<T>` is `User` in `class Users : Repository<User>`. */
private fn substitute(type: TypeRef, params: List<Decl.TypeParam>, args: List<TypeRef>) -> TypeRef {
    if (params.isEmpty() || params.size() != args.size()) {
        return type
    }
    var i = 0
    while (i < params.size()) {
        if (params.get(i).name().equals(type.name()) && type.args().isEmpty()) {
            val arg = args.get(i)
            return TypeRef(type.pos(), arg.name(), arg.args(), arg.nullable() || type.nullable())
        }
        i += 1
    }
    val substituted = type.args() |> map { a -> substitute(a, params, args) }
    return TypeRef(type.pos(), type.name(), substituted, type.nullable())
}

/** What the interfaces require, as `name/arity`: a value is a method without parameters. */
fn required(file: SourceFile, supertypes: List<TypeRef>) -> List<String> {
    val keys = ArrayList<String>()
    for (implemented in interfaces(file, supertypes, HashSet<String>())) {
        val iface = implemented.iface()
        for (member in iface.members()) {
            keys.add(member.name() + "/0")
        }
        for (method in iface.methods()) {
            keys.add(method.name() + "/" + method.params().size())
        }
    }
    return keys
}

/** The interfaces of the file among the supertypes, with the interfaces they extend and the type arguments each gets. */
private fn interfaces(file: SourceFile, supertypes: List<TypeRef>, seen: Set<String>) -> List<Implemented> {
    val result = ArrayList<Implemented>()
    for (type in supertypes) {
        for (decl in file.decls()) {
            if (decl is Decl.Interface && decl.name().equals(type.name()) && seen.add(decl.name())) {
                result.add(Implemented(decl, type.args()))
                // `interface A<T> : B<List<T>>` passes its own arguments on to B.
                val parents = decl.supertypes() |> map { p -> substitute(p, decl.typeParams(), type.args()) }
                result.addAll(interfaces(file, parents, seen))
            }
        }
    }
    return result
}

/** A value may be narrower than required, `String` for `String?`, but its type arguments must match. */
private fn fits(given: TypeRef, required: TypeRef) -> Boolean {
    if (given.nullable() && !required.nullable()) {
        return false
    }
    return given.name().equals(required.name()) && sameArgs(given.args(), required.args())
}

private fn sameArgs(given: List<TypeRef>, required: List<TypeRef>) -> Boolean {
    if (given.size() != required.size()) {
        return false
    }
    var i = 0
    while (i < given.size()) {
        val a = given.get(i)
        val b = required.get(i)
        if (a.nullable() != b.nullable() || !a.name().equals(b.name()) || !sameArgs(a.args(), b.args())) {
            return false
        }
        i += 1
    }
    return true
}

private fn fieldsOf(fields: List<Expr.Param>) -> Map<String, Given> {
    val given = HashMap<String, Given>()
    for (f in fields) {
        given.put(f.name(), Given(f.pos(), f.type()))
    }
    return given
}

private fn propertiesOf(c: Decl.ClassDecl) -> Map<String, Given> {
    val given = HashMap<String, Given>()
    for (p in c.parameters()) {
        given.put(p.name(), Given(p.namePos(), p.type()))
    }
    for (p in c.properties()) {
        given.put(p.name(), Given(p.namePos(), p.type()))
    }
    // A method without parameters gives the value as well.
    for (m in c.methods()) {
        if (m.params().isEmpty()) {
            given.put(m.name(), Given(m.namePos(), m.returnType()))
        }
    }
    return given
}

private fn text(type: TypeRef) -> String {
    val args = type.args() |> map { a -> text(a) }
    val written = if (args.isEmpty()) type.name() else type.name() + "<" + String.join(", ", args) + ">"
    return if (type.nullable()) written + "?" else written
}
