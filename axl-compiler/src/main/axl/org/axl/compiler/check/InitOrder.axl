package org.axl.compiler.check

import java.util.ArrayList
import java.util.HashSet
import java.util.List
import java.util.Set
import org.axl.compiler.ast.Decl
import org.axl.compiler.ast.Expr
import org.axl.compiler.ast.SourceFile
import org.axl.compiler.ast.Stmt

/**
 * Top-level values are static fields set in declaration order, so a value that reads a later one,
 * directly or through functions of the file, sees null or zero. The properties of a class are set in
 * order in its constructor, after its parameters, and the same holds for them.
 */
class InitOrder(val file: SourceFile) {

    // Functions and values already followed while one initializer is checked; a cycle reads nothing new.
    val visited: HashSet<String> = HashSet<String>()

    // The class whose code is being followed: its methods are called by their names alone.
    var owner: Decl.ClassDecl? = null

    fn problems() -> List<Problem> {
        val values = ArrayList<Decl.Value>()
        for (decl in file.decls()) {
            if (decl is Decl.Value) {
                values.add(decl)
            }
        }
        val problems = ArrayList<Problem>()
        var i = 0
        while (i < values.size()) {
            val read = HashSet<String>()
            visited.clear()
            names(values.get(i).init(), Set.of(), read)
            val later = firstRead(values.subList(i, values.size()), read)
            if (later != null) {
                problems.add(Problem(values.get(i), later))
            }
            i += 1
        }
        return problems
    }

    fn propertyProblems() -> List<PropertyProblem> {
        val problems = ArrayList<PropertyProblem>()
        for (decl in file.decls()) {
            if (decl is Decl.ClassDecl) {
                classProblems(decl, problems)
            }
        }
        return problems
    }

    private fn classProblems(c: Decl.ClassDecl, problems: List<PropertyProblem>) {
        val properties = c.properties()
        var i = 0
        while (i < properties.size()) {
            val init = properties.get(i).init()
            if (init != null) {
                val read = HashSet<String>()
                visited.clear()
                owner = c
                names(init, Set.of(), read)
                owner = null
                val later = firstProperty(properties.subList(i, properties.size()), read)
                if (later != null) {
                    problems.add(PropertyProblem(properties.get(i), later))
                } else if (read.contains("this") && i + 1 < properties.size()) {
                    // Code given `this` may read any property, and the later ones are not set yet.
                    problems.add(PropertyProblem(properties.get(i), "this"))
                }
            }
            i += 1
        }
    }

    private fn firstProperty(properties: List<Decl.Property>, read: Set<String>) -> String? {
        for (p in properties) {
            if (read.contains(p.name())) {
                return p.name()
            }
        }
        return null
    }

    private fn firstRead(values: List<Decl.Value>, read: Set<String>) -> String? {
        for (value in values) {
            if (read.contains(value.name())) {
                return value.name()
            }
        }
        return null
    }

    /**
     * Names an expression reads when it runs, following calls into functions of the file.
     *
     * hidden: parameters and locals in scope, which are not the top-level values of the same name.
     */
    private fn names(expr: Expr, hidden: Set<String>, out: Set<String>) {
        when (expr) {
            is Expr.Name -> read(expr.name(), hidden, out)
            is Expr.Call -> callNames(expr, hidden, out)
            is Expr.Member -> {
                if (isThisClass(expr.target()) || isThis(expr.target())) {
                    read(expr.name(), Set.of(), out)
                } else {
                    names(expr.target(), hidden, out)
                }
            }
            is Expr.GenericNew -> arguments(expr.args(), hidden, out)
            is Expr.MethodRef -> {
                if (isThis(expr.target())) {
                    function(expr.name(), out)
                } else {
                    names(expr.target(), hidden, out)
                }
            }
            is Expr.NotNull -> names(expr.target(), hidden, out)
            is Expr.Unary -> names(expr.operand(), hidden, out)
            is Expr.Binary -> {
                names(expr.left(), hidden, out)
                names(expr.right(), hidden, out)
            }
            is Expr.Elvis -> {
                names(expr.left(), hidden, out)
                names(expr.right(), hidden, out)
            }
            is Expr.Is -> names(expr.target(), hidden, out)
            is Expr.Conditional -> {
                names(expr.condition(), hidden, out)
                names(expr.then(), hidden, out)
                names(expr.otherwise(), hidden, out)
            }
            is Expr.Throw -> names(expr.value(), hidden, out)
            is Expr.When -> whenNames(expr, hidden, out)
            is Expr.Paren -> names(expr.inner(), hidden, out)
            is Expr.Try -> names(expr.inner(), hidden, out)
            is Expr.Attempt -> {
                names(expr.body(), hidden, out)
                val errorName = expr.errorName()
                names(expr.handler(), if (errorName == null) hidden else with(hidden, Set.of(errorName)), out)
            }
            is Expr.Pipe -> pipeNames(expr, hidden, out)
            // A lambda that is not passed to a call runs later, if at all.
            is Expr.Lambda -> { }
            is Expr.Literal -> { }
        }
    }

    private fn callNames(call: Expr.Call, hidden: Set<String>, out: Set<String>) {
        val target = call.target()
        if (target == null) {
            if (!hidden.contains(call.name())) {
                function(call.name(), out)
            }
        } else if (isThisClass(target) || isThis(target)) {
            function(call.name(), out)
        } else {
            names(target, hidden, out)
            // `Box().size()` runs a method of a class of this file on the object it creates.
            val created = constructed(target)
            if (created != null) {
                method(created, call.name(), out)
            }
            // `make().get()` calls the lambda that `make` returns.
            val returned = returnedLambda(target)
            if (returned != null) {
                lambdaBody(returned, Set.of(), out)
            }
        }
        arguments(call.args(), hidden, out)
    }

    /** The class of this file that an expression creates an object of, if it is a constructor call. */
    private fn constructed(e: Expr) -> Decl.ClassDecl? {
        val inner = unparenthesized(e)
        if (inner is Expr.Call && inner.target() == null) {
            return classNamed(inner.name())
        }
        return null
    }

    private fn returnedLambda(e: Expr) -> Expr.Lambda? {
        val inner = unparenthesized(e)
        if (inner !is Expr.Call || inner.target() != null) {
            return null
        }
        val c = owner
        val functions = ArrayList<Decl.Function>()
        if (c != null) {
            functions.addAll(c.methods())
        }
        for (decl in file.decls()) {
            if (decl is Decl.Function) {
                functions.add(decl)
            }
        }
        for (f in functions) {
            val body = f.exprBody()
            if (f.name().equals(inner.name()) && body != null && unparenthesized(body) is Expr.Lambda) {
                return lambdaOf(body)
            }
        }
        return null
    }

    private fn classNamed(name: String) -> Decl.ClassDecl? {
        for (decl in file.decls()) {
            if (decl is Decl.ClassDecl && decl.name().equals(name)) {
                return decl
            }
        }
        return null
    }

    /** Creating an object runs the initializers of its properties. */
    private fn constructor(c: Decl.ClassDecl, out: Set<String>) {
        if (!visited.add("new " + c.name())) {
            return
        }
        val outer = owner
        owner = c
        for (p in c.properties()) {
            val init = p.init()
            if (init != null) {
                names(init, Set.of(), out)
            }
        }
        owner = outer
    }

    private fn method(c: Decl.ClassDecl, name: String, out: Set<String>) {
        val outer = owner
        owner = c
        for (m in c.methods()) {
            if (m.name().equals(name) && visited.add("method " + c.name() + "." + name)) {
                body(m, out)
            }
        }
        owner = outer
    }

    private fn whenNames(w: Expr.When, hidden: Set<String>, out: Set<String>) {
        names(w.subject(), hidden, out)
        val binding = w.bindingName()
        val inArms = if (binding == null) hidden else with(hidden, Set.of(binding))
        for (arm in w.arms()) {
            statements(arm.body(), inArms, out)
        }
    }

    private fn pipeNames(pipe: Expr.Pipe, hidden: Set<String>, out: Set<String>) {
        names(pipe.source(), hidden, out)
        for (stage in pipe.stages()) {
            for (arg in stage.args()) {
                names(arg, hidden, out)
            }
            val lambda = stage.lambda()
            if (lambda != null) {
                lambdaBody(lambda, hidden, out)
            }
        }
    }

    /** A lambda or function reference passed to a call is likely called by it. */
    private fn arguments(args: List<Expr>, hidden: Set<String>, out: Set<String>) {
        for (arg in args) {
            val inner = unparenthesized(arg)
            if (inner is Expr.Lambda) {
                lambdaBody(inner, hidden, out)
            } else if (inner is Expr.MethodRef && (isThisClass(inner.target()) || isThis(inner.target()))) {
                function(inner.name(), out)
            } else {
                names(arg, hidden, out)
            }
        }
    }

    private fn read(name: String, hidden: Set<String>, out: Set<String>) {
        if (hidden.contains(name)) {
            return
        }
        out.add(name)
        // Reading a value that holds a lambda is usually done to call it.
        for (decl in file.decls()) {
            if (decl is Decl.Value && decl.name().equals(name) && visited.add("val " + name)) {
                val init = unparenthesized(decl.init())
                if (init is Expr.Lambda) {
                    lambdaBody(init, Set.of(), out)
                } else if (init is Expr.MethodRef && isThisClass(init.target())) {
                    function(init.name(), out)
                }
            }
        }
    }

    private fn lambdaBody(lambda: Expr.Lambda, hidden: Set<String>, out: Set<String>) {
        val scope = HashSet<String>(hidden)
        for (param in lambda.params()) {
            scope.add(param.name())
        }
        if (lambda.params().isEmpty()) {
            scope.add("it")
        }
        statements(lambda.body(), scope, out)
    }

    private fn function(name: String, out: Set<String>) {
        val c = owner
        if (c != null && hasMethod(c, name)) {
            method(c, name, out)
            return
        }
        val created = classNamed(name)
        if (created != null) {
            constructor(created, out)
            return
        }
        if (!visited.add("fn " + name)) {
            return
        }
        // Outside the class a function of the file is called by its name; inside, a method would be.
        val outer = owner
        owner = null
        for (decl in file.decls()) {
            if (decl is Decl.Function && decl.name().equals(name)) {
                body(decl, out)
            }
        }
        owner = outer
    }

    private fn body(f: Decl.Function, out: Set<String>) {
        val scope = HashSet<String>()
        for (param in f.params()) {
            scope.add(param.name())
        }
        val exprBody = f.exprBody()
        val block = f.body()
        if (exprBody != null) {
            names(exprBody, scope, out)
        } else if (block != null) {
            statements(block.statements(), scope, out)
        }
    }

    /** `Main.names` and `app.Main.names` name a value of this file too. */
    private fn isThisClass(target: Expr) -> Boolean {
        val text = dotted(target)
        if (text == null) {
            return false
        }
        val packageName = file.packageName()!!
        val qualified = if (packageName.isEmpty()) file.className() else packageName + "." + file.className()
        return text.equals(file.className()) || text.equals(qualified)
    }

    /** A local hides the value of the same name from its declaration to the end of its block. */
    private fn statements(statements: List<Stmt>, hidden: Set<String>, out: Set<String>) {
        val scope = HashSet<String>(hidden)
        for (stmt in statements) {
            statement(stmt, scope, out)
            if (stmt is Stmt.Local) {
                scope.add(stmt.name())
            }
        }
    }

    private fn statement(stmt: Stmt, hidden: Set<String>, out: Set<String>) {
        when (stmt) {
            is Stmt.Local -> {
                val init = unparenthesized(stmt.init())
                // A lambda kept in a local is there to be called.
                if (init is Expr.Lambda) {
                    lambdaBody(init, hidden, out)
                } else {
                    names(stmt.init(), hidden, out)
                }
            }
            is Stmt.Assign -> {
                names(stmt.target(), hidden, out)
                names(stmt.value(), hidden, out)
            }
            is Stmt.Return -> {
                val value = stmt.value()
                if (value != null) {
                    names(value, hidden, out)
                }
            }
            is Stmt.If -> {
                names(stmt.condition(), hidden, out)
                statement(stmt.then(), hidden, out)
                val otherwise = stmt.elseBranch()
                if (otherwise != null) {
                    statement(otherwise, hidden, out)
                }
            }
            is Stmt.While -> {
                names(stmt.condition(), hidden, out)
                statement(stmt.body(), hidden, out)
            }
            is Stmt.For -> {
                names(stmt.iterable(), hidden, out)
                statement(stmt.body(), with(hidden, Set.of(stmt.name())), out)
            }
            is Stmt.ExprStmt -> names(stmt.expr(), hidden, out)
            is Stmt.Block -> statements(stmt.statements(), hidden, out)
        }
    }
}

/** A value and a later value it reads while it is initialized. */
data class Problem(val value: Decl.Value, val later: String)

/** A property of a class and a later property it reads while it is initialized. */
data class PropertyProblem(val property: Decl.Property, val later: String)

fn check(file: SourceFile) -> List<Problem> = InitOrder(file).problems()

fn checkProperties(file: SourceFile) -> List<PropertyProblem> = InitOrder(file).propertyProblems()

private fn hasMethod(c: Decl.ClassDecl, name: String) -> Boolean = c.methods() |> anyMatch { m -> m.name().equals(name) }

private fn lambdaOf(expr: Expr) -> Expr.Lambda? {
    val inner = unparenthesized(expr)
    return if (inner is Expr.Lambda) inner else null
}

private fn isThis(expr: Expr) -> Boolean = expr is Expr.Name && expr.name().equals("this")

private fn unparenthesized(expr: Expr) -> Expr = if (expr is Expr.Paren) expr.inner() else expr

private fn dotted(expr: Expr) -> String? {
    if (expr is Expr.Name) {
        return expr.name()
    }
    if (expr is Expr.Member && !expr.safe()) {
        val target = dotted(expr.target())
        return if (target == null) null else target + "." + expr.name()
    }
    return null
}

private fn with(names: Set<String>, more: Set<String>) -> Set<String> {
    val result = HashSet<String>(names)
    result.addAll(more)
    return result
}
