package org.axl.compiler.check

import java.util.ArrayList
import java.util.HashMap
import java.util.HashSet
import java.util.List
import java.util.Map
import java.util.Set
import org.axl.compiler.ast.Decl
import org.axl.compiler.ast.Expr
import org.axl.compiler.ast.SourceFile
import org.axl.compiler.ast.Stmt
import org.axl.compiler.ast.TypeRef

/**
 * Top-level values are static fields set in declaration order, so a value that reads a later one,
 * directly or through functions of the file, sees null or zero. The properties of a class are set in
 * order in its constructor, after its parameters, and the same holds for them.
 */
class InitOrder(val file: SourceFile) {

    // Functions and values already followed while one initializer is checked; a cycle reads nothing new.
    val visited: HashSet<String> = HashSet<String>()

    // The class whose code is being followed: its methods are called by their names alone.
    var owner: Decl.ClassDecl? = null

    // The type names of the parameters and locals in scope in the code being followed, and the type
    // names of the elements of those that are collections.
    var classes: Map<String, String> = HashMap<String, String>()
    var elements: Map<String, String> = HashMap<String, String>()

    // The method reference passed to a call that the code being followed runs in, if any, and the names
    // read only that way: the call may not run the reference at all.
    var keeping: Kept? = null
    val keptBy: HashMap<String, Kept> = HashMap<String, Kept>()
    val direct: HashSet<String> = HashSet<String>()

    fn problems() -> List<Problem> {
        val values = ArrayList<Decl.Value>()
        for (decl in file.decls()) {
            if (decl is Decl.Value) {
                values.add(decl)
            }
        }
        val problems = ArrayList<Problem>()
        var i = 0
        while (i < values.size()) {
            val read = HashSet<String>()
            visited.clear()
            names(values.get(i).init(), Set.of(), read)
            val later = firstRead(values.subList(i, values.size()), read)
            if (later != null) {
                problems.add(Problem(values.get(i), later))
            }
            i += 1
        }
        return problems
    }

    fn propertyProblems() -> List<PropertyProblem> {
        val problems = ArrayList<PropertyProblem>()
        for (decl in file.decls()) {
            if (decl is Decl.ClassDecl) {
                classProblems(decl, problems)
            }
        }
        return problems
    }

    private fn classProblems(c: Decl.ClassDecl, problems: List<PropertyProblem>) {
        val properties = c.properties()
        var i = 0
        while (i < properties.size()) {
            val init = properties.get(i).init()
            if (init != null) {
                val read = HashSet<String>()
                visited.clear()
                keptBy.clear()
                direct.clear()
                owner = c
                names(init, Set.of(), read)
                owner = null
                val later = firstProperty(properties.subList(i, properties.size()), read)
                if (later != null) {
                    val kept = if (direct.contains(later)) null else keptBy.get(later)
                    problems.add(PropertyProblem(properties.get(i), later, kept))
                } else if (read.contains("this") && i + 1 < properties.size()) {
                    // Code given `this` may read any property, and the later ones are not set yet.
                    problems.add(PropertyProblem(properties.get(i), "this", null))
                }
            }
            i += 1
        }
    }

    private fn firstProperty(properties: List<Decl.Property>, read: Set<String>) -> String? {
        for (p in properties) {
            if (read.contains(p.name())) {
                return p.name()
            }
        }
        return null
    }

    private fn firstRead(values: List<Decl.Value>, read: Set<String>) -> String? {
        for (value in values) {
            if (read.contains(value.name())) {
                return value.name()
            }
        }
        return null
    }

    /**
     * Names an expression reads when it runs, following calls into functions of the file.
     *
     * hidden: parameters and locals in scope, which are not the top-level values of the same name.
     */
    private fn names(expr: Expr, hidden: Set<String>, out: Set<String>) {
        when (expr) {
            is Expr.Name -> read(expr.name(), hidden, out)
            is Expr.Call -> callNames(expr, hidden, out)
            is Expr.Member -> {
                if (isThisClass(expr.target()) || isThis(expr.target())) {
                    read(expr.name(), Set.of(), out)
                } else {
                    names(expr.target(), hidden, out)
                }
            }
            is Expr.GenericNew -> arguments(expr.type(), expr.args(), hidden, out)
            // Taking a reference runs nothing; storing, passing or calling it is followed where it happens.
            is Expr.MethodRef -> {
                if (!isThis(expr.target())) {
                    names(expr.target(), hidden, out)
                }
            }
            is Expr.NotNull -> names(expr.target(), hidden, out)
            is Expr.ClassLiteral -> { }
            is Expr.Unary -> names(expr.operand(), hidden, out)
            is Expr.Binary -> {
                names(expr.left(), hidden, out)
                names(expr.right(), hidden, out)
                if (expr.op().equals("+")) {
                    // `"x" + box` calls the toString of the box.
                    toStringOf(expr.left(), hidden, out)
                    toStringOf(expr.right(), hidden, out)
                }
            }
            is Expr.Elvis -> {
                names(expr.left(), hidden, out)
                names(expr.right(), hidden, out)
            }
            is Expr.Is -> names(expr.target(), hidden, out)
            is Expr.Conditional -> {
                names(expr.condition(), hidden, out)
                names(expr.then(), hidden, out)
                names(expr.otherwise(), hidden, out)
            }
            is Expr.Throw -> names(expr.value(), hidden, out)
            is Expr.When -> whenNames(expr, hidden, out)
            is Expr.Paren -> names(expr.inner(), hidden, out)
            is Expr.Try -> names(expr.inner(), hidden, out)
            is Expr.Attempt -> {
                names(expr.body(), hidden, out)
                val errorName = expr.errorName()
                names(expr.handler(), if (errorName == null) hidden else with(hidden, Set.of(errorName)), out)
            }
            is Expr.Pipe -> pipeNames(expr, hidden, out)
            // A lambda that is not passed to a call runs later, if at all.
            is Expr.Lambda -> { }
            is Expr.Literal -> { }
        }
    }

    private fn callNames(call: Expr.Call, hidden: Set<String>, out: Set<String>) {
        val target = call.target()
        if (target == null) {
            if (!hidden.contains(call.name())) {
                function(call.name(), out)
            }
        } else if (isThisClass(target) || isThis(target)) {
            function(call.name(), out)
        } else {
            names(target, hidden, out)
            // `Box().size()`, `box.size()` or `make().size()` runs a method of a class of this file.
            val receiver = classOf(target, hidden)
            if (receiver != null) {
                method(receiver, call.name(), out)
            }
            // `make().get()` calls the lambda that `make` returns.
            val returned = returnedLambda(target)
            if (returned != null) {
                lambdaBody(returned, Set.of(), out, null)
            }
        }
        arguments(call.name(), call.args(), hidden, out)
    }

    private fn toStringOf(e: Expr, hidden: Set<String>, out: Set<String>) {
        val c = classOf(e, hidden)
        if (c != null) {
            method(c, "toString", out)
        }
    }

    /**
     * The class of this file an expression has: an object it creates, a parameter, local or top-level
     * value, an element of a collection or a function result of that class.
     */
    private fn classOf(e: Expr, hidden: Set<String>) -> Decl.ClassDecl? {
        val created = constructed(e)
        if (created != null) {
            return created
        }
        val inner = unparenthesized(e)
        if (inner is Expr.Name) {
            val local = classes.get(inner.name())
            if (local != null) {
                return classNamed(local)
            }
            return if (hidden.contains(inner.name())) null else valueClass(inner.name())
        }
        if (inner is Expr.Call) {
            val target = inner.target()
            if (target == null) {
                return resultClass(inner.name())
            }
            val element = if (ELEMENT_GETTERS.contains(inner.name())) elementOf(target, hidden) else null
            return if (element == null) null else classNamed(element)
        }
        return null
    }

    private fn resultClass(function: String) -> Decl.ClassDecl? {
        for (decl in file.decls()) {
            val result = if (decl is Decl.Function && decl.name().equals(function)) decl.returnType() else null
            if (result != null) {
                return classNamed(result.name())
            }
        }
        return null
    }

    private fn valueClass(name: String) -> Decl.ClassDecl? {
        for (decl in file.decls()) {
            if (decl is Decl.Value && decl.name().equals(name)) {
                val type = decl.type()
                return if (type != null) classNamed(type.name()) else constructed(decl.init())
            }
        }
        return null
    }

    /** The type name of the elements of a collection: a parameter, local or value, or `List.of(a, ...)`. */
    private fn elementOf(e: Expr, hidden: Set<String>) -> String? {
        val inner = unparenthesized(e)
        if (inner is Expr.Name) {
            val local = elements.get(inner.name())
            if (local != null || hidden.contains(inner.name())) {
                return local
            }
            return valueElement(inner.name())
        }
        if (inner is Expr.Call && inner.target() != null && inner.name().equals("of") && !inner.args().isEmpty()) {
            val first = classOf(inner.args().get(0), hidden)
            return if (first == null) null else first.name()
        }
        return null
    }

    private fn valueElement(name: String) -> String? {
        for (decl in file.decls()) {
            if (decl is Decl.Value && decl.name().equals(name)) {
                val type = decl.type()
                // `val a = b` with `val b = a` would never end.
                val init = decl.init()
                return if (type != null) elementName(type) else if (unparenthesized(init) is Expr.Name) null else elementOf(init, Set.of())
            }
        }
        return null
    }

    /** Remembers or forgets what a parameter or local holds, as a later one of the same name hides it. */
    private fn track(name: String, type: String?, element: String?) {
        if (type == null) {
            classes.remove(name)
        } else {
            classes.put(name, type)
        }
        if (element == null) {
            elements.remove(name)
        } else {
            elements.put(name, element)
        }
    }

    /** The class of this file that an expression creates an object of, if it is a constructor call. */
    private fn constructed(e: Expr) -> Decl.ClassDecl? {
        val inner = unparenthesized(e)
        if (inner is Expr.Call && inner.target() == null) {
            return classNamed(inner.name())
        }
        return null
    }

    private fn returnedLambda(e: Expr) -> Expr.Lambda? {
        val inner = unparenthesized(e)
        if (inner !is Expr.Call || inner.target() != null) {
            return null
        }
        val c = owner
        val functions = ArrayList<Decl.Function>()
        if (c != null) {
            functions.addAll(c.methods())
        }
        for (decl in file.decls()) {
            if (decl is Decl.Function) {
                functions.add(decl)
            }
        }
        for (f in functions) {
            val body = f.exprBody()
            if (f.name().equals(inner.name()) && body != null && unparenthesized(body) is Expr.Lambda) {
                return lambdaOf(body)
            }
        }
        return null
    }

    private fn classNamed(name: String) -> Decl.ClassDecl? {
        for (decl in file.decls()) {
            if (decl is Decl.ClassDecl && decl.name().equals(name)) {
                return decl
            }
        }
        return null
    }

    /** Creating an object runs the initializers of its properties. */
    private fn constructor(c: Decl.ClassDecl, out: Set<String>) {
        if (!visited.add("new " + c.name())) {
            return
        }
        val outer = owner
        owner = c
        for (p in c.properties()) {
            val init = p.init()
            if (init != null) {
                names(init, Set.of(), out)
            }
        }
        // Any of its other constructors may be the one called.
        for (k in c.constructors()) {
            val params = HashSet<String>(k.params() |> map { p -> p.name() })
            for (a in k.args()) {
                names(a, params, out)
            }
        }
        owner = outer
    }

    private fn method(c: Decl.ClassDecl, name: String, out: Set<String>) {
        val outer = owner
        owner = c
        for (m in c.methods()) {
            if (m.name().equals(name) && visited.add("method " + c.name() + "." + name)) {
                body(m, out)
            }
        }
        owner = outer
    }

    private fn whenNames(w: Expr.When, hidden: Set<String>, out: Set<String>) {
        names(w.subject(), hidden, out)
        val binding = w.bindingName()
        val inArms = if (binding == null) hidden else with(hidden, Set.of(binding))
        for (arm in w.arms()) {
            statements(arm.body(), inArms, out)
        }
    }

    private fn pipeNames(pipe: Expr.Pipe, hidden: Set<String>, out: Set<String>) {
        names(pipe.source(), hidden, out)
        var element = elementOf(pipe.source(), hidden)
        for (stage in pipe.stages()) {
            for (arg in stage.args()) {
                names(arg, hidden, out)
            }
            val lambda = stage.lambda()
            if (lambda != null) {
                lambdaBody(lambda, hidden, out, element)
            }
            if (!SAME_ELEMENTS.contains(stage.name())) {
                element = null
            }
        }
    }

    /** A lambda or function reference passed to a call is likely called by it. */
    private fn arguments(callee: String, args: List<Expr>, hidden: Set<String>, out: Set<String>) {
        for (arg in args) {
            val inner = unparenthesized(arg)
            if (inner is Expr.Lambda) {
                lambdaBody(inner, hidden, out, null)
            } else {
                names(arg, hidden, out)
                if (inner is Expr.MethodRef) {
                    val outer = keeping
                    // A constructor usually keeps what it is given; other calls, such as `mapToInt`, run it.
                    val path = Expr.pathName(inner.target())
                    val constructor = Character.isUpperCase(simpleName(callee).charAt(0))
                    keeping = outer ?: (if (path == null || !constructor) null else Kept(path + "::" + inner.name(), simpleName(callee)))
                    calledRef(inner, hidden, out)
                    keeping = outer
                }
            }
        }
    }

    /** What calling `this::m`, `Main::m` or `box::m` runs, where the box has a class of this file. */
    private fn calledRef(ref: Expr.MethodRef, hidden: Set<String>, out: Set<String>) {
        if (isThisClass(ref.target()) || isThis(ref.target())) {
            function(ref.name(), out)
            return
        }
        val c = classOf(ref.target(), hidden)
        if (c != null) {
            method(c, ref.name(), out)
        }
    }

    private fn read(name: String, hidden: Set<String>, out: Set<String>) {
        if (hidden.contains(name)) {
            return
        }
        out.add(name)
        val kept = keeping
        if (kept == null) {
            direct.add(name)
        } else {
            keptBy.putIfAbsent(name, kept)
        }
        // Reading a value or a property that holds a lambda is usually done to call it.
        val c = owner
        if (c != null) {
            for (p in c.properties()) {
                val init = p.init()
                if (p.name().equals(name) && init != null && visited.add("property " + c.name() + "." + name)) {
                    calledValue(unparenthesized(init), out)
                }
            }
        }
        for (decl in file.decls()) {
            if (decl is Decl.Value && decl.name().equals(name) && visited.add("val " + name)) {
                calledValue(unparenthesized(decl.init()), out)
            }
        }
    }

    /** A value or property initializer, which sees none of the locals of the code that reads it. */
    private fn calledValue(init: Expr, out: Set<String>) {
        val outerClasses = classes
        val outerElements = elements
        classes = HashMap<String, String>()
        elements = HashMap<String, String>()
        if (init is Expr.Lambda) {
            lambdaBody(init, Set.of(), out, null)
        } else if (init is Expr.MethodRef) {
            calledRef(init, Set.of(), out)
        }
        classes = outerClasses
        elements = outerElements
    }

    /** element: the type name of the single parameter, as in a stage of a pipe over a collection. */
    private fn lambdaBody(lambda: Expr.Lambda, hidden: Set<String>, out: Set<String>, element: String?) {
        val outerClasses = classes
        val outerElements = elements
        classes = HashMap<String, String>(classes)
        elements = HashMap<String, String>(elements)
        val scope = HashSet<String>(hidden)
        for (param in lambda.params()) {
            scope.add(param.name())
            val type = param.type()
            track(param.name(), if (type == null) element else type.name(), if (type == null) null else elementName(type))
        }
        if (lambda.params().isEmpty()) {
            scope.add("it")
            track("it", element, null)
        }
        statements(lambda.body(), scope, out)
        classes = outerClasses
        elements = outerElements
    }

    private fn function(name: String, out: Set<String>) {
        val c = owner
        if (c != null && hasMethod(c, name)) {
            method(c, name, out)
            return
        }
        val created = classNamed(name)
        if (created != null) {
            constructor(created, out)
            return
        }
        if (!visited.add("fn " + name)) {
            return
        }
        // Outside the class a function of the file is called by its name; inside, a method would be.
        val outer = owner
        owner = null
        for (decl in file.decls()) {
            if (decl is Decl.Function && decl.name().equals(name)) {
                body(decl, out)
            }
        }
        owner = outer
    }

    private fn body(f: Decl.Function, out: Set<String>) {
        val outerClasses = classes
        val outerElements = elements
        classes = HashMap<String, String>()
        elements = HashMap<String, String>()
        val scope = HashSet<String>()
        for (param in f.params()) {
            scope.add(param.name())
            val type = param.type()
            if (type != null) {
                track(param.name(), type.name(), elementName(type))
            }
        }
        val exprBody = f.exprBody()
        val block = f.body()
        if (exprBody != null) {
            names(exprBody, scope, out)
        } else if (block != null) {
            statements(block.statements(), scope, out)
        }
        classes = outerClasses
        elements = outerElements
    }

    /** `Main.names` and `app.Main.names` name a value of this file too. */
    private fn isThisClass(target: Expr) -> Boolean {
        val text = dotted(target)
        if (text == null) {
            return false
        }
        val packageName = file.packageName()!!
        val qualified = if (packageName.isEmpty()) file.className() else packageName + "." + file.className()
        return text.equals(file.className()) || text.equals(qualified)
    }

    /** A local hides the value of the same name from its declaration to the end of its block. */
    private fn statements(statements: List<Stmt>, hidden: Set<String>, out: Set<String>) {
        val scope = HashSet<String>(hidden)
        for (stmt in statements) {
            statement(stmt, scope, out)
            if (stmt is Stmt.Local) {
                scope.add(stmt.name())
            }
        }
    }

    private fn statement(stmt: Stmt, hidden: Set<String>, out: Set<String>) {
        when (stmt) {
            is Stmt.Local -> {
                val init = unparenthesized(stmt.init())
                // A lambda or a function reference kept in a local is there to be called.
                if (init is Expr.Lambda) {
                    lambdaBody(init, hidden, out, null)
                } else {
                    names(stmt.init(), hidden, out)
                    if (init is Expr.MethodRef) {
                        calledRef(init, hidden, out)
                    }
                }
                val type = stmt.type()
                if (type != null) {
                    track(stmt.name(), type.name(), elementName(type))
                } else {
                    val c = classOf(init, hidden)
                    track(stmt.name(), if (c == null) null else c.name(), elementOf(init, hidden))
                }
            }
            is Stmt.Assign -> {
                names(stmt.target(), hidden, out)
                names(stmt.value(), hidden, out)
            }
            is Stmt.Return -> {
                val value = stmt.value()
                if (value != null) {
                    names(value, hidden, out)
                }
            }
            is Stmt.Jump -> { }
            is Stmt.AttemptExit -> {
                names(stmt.body(), hidden, out)
                val errorName = stmt.errorName()
                statement(stmt.exit(), if (errorName == null) hidden else with(hidden, Set.of(errorName)), out)
            }
            is Stmt.Use -> {
                names(stmt.resource(), hidden, out)
                statement(stmt.body(), with(hidden, Set.of(stmt.name())), out)
                val handler = stmt.handler()
                val errorName = stmt.errorName()
                if (handler != null) {
                    names(handler, if (errorName == null) hidden else with(hidden, Set.of(errorName)), out)
                }
            }
            is Stmt.If -> {
                names(stmt.condition(), hidden, out)
                statement(stmt.then(), hidden, out)
                val otherwise = stmt.elseBranch()
                if (otherwise != null) {
                    statement(otherwise, hidden, out)
                }
            }
            is Stmt.While -> {
                names(stmt.condition(), hidden, out)
                statement(stmt.body(), hidden, out)
            }
            is Stmt.For -> {
                names(stmt.iterable(), hidden, out)
                track(stmt.name(), elementOf(stmt.iterable(), hidden), null)
                statement(stmt.body(), with(hidden, Set.of(stmt.name())), out)
            }
            is Stmt.Count -> {
                names(stmt.from(), hidden, out)
                names(stmt.to(), hidden, out)
                val step = stmt.step()
                if (step != null) {
                    names(step, hidden, out)
                }
                track(stmt.name(), null, null)
                statement(stmt.body(), with(hidden, Set.of(stmt.name())), out)
            }
            is Stmt.ExprStmt -> names(stmt.expr(), hidden, out)
            is Stmt.Block -> statements(stmt.statements(), hidden, out)
        }
    }
}

/** A value and a later value it reads while it is initialized. */
data class Problem(val value: Decl.Value, val later: String)

/** A property of a class and a later property it reads while it is initialized. */
data class PropertyProblem(val property: Decl.Property, val later: String, val kept: Kept?)

/** A method reference, `this::count`, passed to a constructor, `Rule`, which may or may not run it. */
data class Kept(val ref: String, val callee: String)

fn check(file: SourceFile) -> List<Problem> = InitOrder(file).problems()

fn checkProperties(file: SourceFile) -> List<PropertyProblem> = InitOrder(file).propertyProblems()

// Calls that give an element of the collection they are called on.
private val ELEMENT_GETTERS: Set<String> = Set.of("get", "getFirst", "getLast", "first", "last")

// Pipe stages whose output holds the elements of their input.
private val SAME_ELEMENTS: Set<String> = Set.of("filter", "sorted", "distinct", "peek", "limit", "skip", "takeWhile", "dropWhile")

/** The last type argument, which is the element of a list or set and the value of a map. */
private fn elementName(type: TypeRef) -> String? = if (type.args().isEmpty()) null else type.args().get(type.args().size() - 1).name()

private fn hasMethod(c: Decl.ClassDecl, name: String) -> Boolean = c.methods() |> anyMatch { m -> m.name().equals(name) }

private fn lambdaOf(expr: Expr) -> Expr.Lambda? {
    val inner = unparenthesized(expr)
    return if (inner is Expr.Lambda) inner else null
}

private fn isThis(expr: Expr) -> Boolean = expr is Expr.Name && expr.name().equals("this")

private fn simpleName(name: String) -> String = name.substring(name.lastIndexOf('.') + 1)

private fn unparenthesized(expr: Expr) -> Expr = if (expr is Expr.Paren) expr.inner() else expr

private fn dotted(expr: Expr) -> String? {
    if (expr is Expr.Name) {
        return expr.name()
    }
    if (expr is Expr.Member && !expr.safe()) {
        val target = dotted(expr.target())
        return if (target == null) null else target + "." + expr.name()
    }
    return null
}

private fn with(names: Set<String>, more: Set<String>) -> Set<String> {
    val result = HashSet<String>(names)
    result.addAll(more)
    return result
}
