#!/bin/sh
# Puts axl on the PATH and installs the Maven artifacts for the user who is logged in.
mkdir -p /usr/local/bin
ln -sf /Applications/axl.app/Contents/MacOS/axl /usr/local/bin/axl

user="$(stat -f%Su /dev/console)"
if [ -n "$user" ] && [ "$user" != root ]; then
    sudo -u "$user" -H /Applications/axl.app/Contents/MacOS/axl setup || true
fi
exit 0
