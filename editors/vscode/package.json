{
  "name": "axolotl",
  "displayName": "Axolotl",
  "description": "Axolotl language support: highlighting, diagnostics with NullAway, completion, navigation and generated Java.",
  "version": "0.3.0",
  "publisher": "axl",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sora-vuv/axolotl-lang"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "axl",
        "aliases": ["Axolotl", "axl"],
        "extensions": [".axl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axl",
        "scopeName": "source.axl",
        "path": "./syntaxes/axl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "axl.openGeneratedJava",
        "title": "Show Generated Java",
        "category": "Axolotl"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "axl.openGeneratedJava",
          "when": "editorLangId == axl"
        }
      ],
      "commandPalette": [
        {
          "command": "axl.openGeneratedJava",
          "when": "editorLangId == axl"
        }
      ]
    },
    "configuration": {
      "title": "Axolotl",
      "properties": {
        "axl.java.home": {
          "type": "string",
          "default": "",
          "description": "JDK 21+ used to run the language server. Defaults to JAVA_HOME, then `java` on the PATH."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
