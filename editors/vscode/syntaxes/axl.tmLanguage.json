{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Axolotl",
  "scopeName": "source.axl",
  "fileTypes": ["axl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.axl", "match": "//.*$" },
        { "name": "comment.block.axl", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.axl",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "name": "constant.character.escape.axl", "match": "\\\\." }]
        },
        { "name": "string.quoted.single.axl", "match": "'(\\\\.|[^'\\\\])+'" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.axl", "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*[lL]?\\b" },
        { "name": "constant.numeric.decimal.axl", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?[lLfFdD]?\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.axl" },
            "2": { "name": "entity.name.function.axl" }
          }
        },
        {
          "match": "\\b(data)\\s+(class)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.axl" },
            "2": { "name": "keyword.declaration.type.axl" },
            "3": { "name": "entity.name.type.class.axl" }
          }
        },
        {
          "match": "\\b(class)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.axl" },
            "2": { "name": "entity.name.type.class.axl" }
          }
        },
        {
          "begin": "\\b(enum)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.type.axl" },
            "2": { "name": "entity.name.type.enum.axl" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "name": "variable.other.enummember.axl", "match": "[\\p{L}_$][\\p{L}\\p{N}_$]*" }
          ]
        },
        {
          "match": "\\b(interface)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.axl" },
            "2": { "name": "entity.name.type.interface.axl" }
          }
        },
        {
          "match": "\\b(for)\\s*\\(\\s*([\\p{L}_$][\\p{L}\\p{N}_$]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.axl" },
            "2": { "name": "variable.other.declaration.axl" },
            "3": { "name": "keyword.control.axl" }
          }
        },
        {
          "match": "\\b(val|var)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.axl" },
            "2": { "name": "variable.other.declaration.axl" }
          }
        },
        {
          "match": "\\b(package|import)\\s+(fn\\s+|val\\s+)?([\\p{L}_$][\\p{L}\\p{N}_$.]*)",
          "captures": {
            "1": { "name": "keyword.other.import.axl" },
            "2": { "name": "keyword.other.import.axl" },
            "3": { "name": "entity.name.namespace.axl" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.axl", "match": "\\b(if|else|while|for|when|is|return|throw|try|attempt)\\b" },
        { "name": "keyword.control.axl", "match": "^\\s*in\\b(?=\\s+[\\p{L}_$(])" },
        { "name": "keyword.declaration.function.axl", "match": "\\bfn\\b" },
        { "name": "keyword.declaration.type.axl", "match": "\\b(data(?=\\s+class\\b)|class|enum|interface)\\b" },
        { "name": "keyword.declaration.variable.axl", "match": "\\b(val|var)\\b" },
        { "name": "keyword.other.import.axl", "match": "\\b(package|import)\\b" },
        { "name": "keyword.control.axl", "match": "!\\s*is\\b" },
        { "name": "storage.modifier.axl", "match": "\\b(private|sealed)\\b" },
        { "name": "constant.language.axl", "match": "\\b(true|false|null)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.null-safe.axl", "match": "\\?\\.|\\?:|!!" },
        { "name": "keyword.operator.pipe.axl", "match": "\\|>" },
        { "name": "keyword.operator.arrow.axl", "match": "->" },
        { "name": "keyword.operator.method-reference.axl", "match": "::" },
        { "name": "keyword.operator.axl", "match": "==|!=|<=|>=|&&|\\|\\||[-+*/%!<>=]=?" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "variable.other.constant.axl", "match": "(?<=\\.)\\p{Lu}[\\p{Lu}\\p{N}_]*\\b(?!\\s*[(.<])" },
        { "name": "entity.name.type.axl", "match": "\\b\\p{Lu}[\\p{L}\\p{N}_$]*(\\?(?![.:]))?" }
      ]
    },
    "calls": {
      "patterns": [
        { "name": "entity.name.function.call.axl", "match": "\\b[\\p{Ll}_$][\\p{L}\\p{N}_$]*(?=\\s*\\()" }
      ]
    }
  }
}
