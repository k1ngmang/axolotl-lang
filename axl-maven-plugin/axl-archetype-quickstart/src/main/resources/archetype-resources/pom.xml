<?xml version="1.0" encoding="UTF-8"?>
#set( $symbol_dollar = '$' )
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <version>${version}</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <axl.version>${axlVersion}</axl.version>
    <errorprone.version>2.50.0</errorprone.version>
    <nullaway.version>0.14.2</nullaway.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.axl</groupId>
      <artifactId>axl-runtime</artifactId>
      <version>${symbol_dollar}{axl.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
    <!-- Rewrites stack traces of failing tests to .axl lines. -->
    <dependency>
      <groupId>org.axl</groupId>
      <artifactId>axl-smap</artifactId>
      <version>${symbol_dollar}{axl.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.axl</groupId>
        <artifactId>axl-maven-plugin</artifactId>
        <version>${symbol_dollar}{axl.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
              <goal>generate-test</goal>
              <goal>smap</goal>
              <goal>smap-test</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -Xep:IdentityBinaryExpression:WARN -Xep:BadImport:OFF -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:OnlyNullMarked=true</arg>
            <!-- Set by axl:generate: reports errors in generated code at the .axl lines. -->
            <arg>${symbol_dollar}{axl.javacPlugin}</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${symbol_dollar}{errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${symbol_dollar}{nullaway.version}</version>
            </path>
            <path>
              <groupId>org.axl</groupId>
              <artifactId>axl-compiler-javac</artifactId>
              <version>${symbol_dollar}{axl.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <properties>
            <configurationParameters>junit.jupiter.extensions.autodetection.enabled = true</configurationParameters>
          </properties>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
