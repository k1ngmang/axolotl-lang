package app

import java.util.Scanner

fn main() {
    use (val scanner = Scanner(java.nio.file.Path.of("x"))) {
        println(scanner.hasNext())
    }
    use (val n = 5) {
        println(n)
    }
    // Opening and closing both throw: one message for the resource.
    use (val reader = java.io.FileReader("x")) {
        println(reader)
    }
}
