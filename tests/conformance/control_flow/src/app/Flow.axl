package app

fn classify(n: Int) -> String {
    if (n < 0) {
        return "negative"
    } else if (n == 0) {
        return "zero"
    } else {
        return "positive"
    }
}

fn main() {
    var i = -1
    while (i <= 1) {
        println(classify(i))
        i = i + 1
    }
    val big: Long = 10000000000L
    val ratio: Double = 1.5
    val flag: Boolean = !false && big > 1L || ratio < 0.0
    println(flag)
    println(-big % 7)
}
