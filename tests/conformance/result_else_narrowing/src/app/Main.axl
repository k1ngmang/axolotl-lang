package app

fn parse(s: String) -> Result<Int, String> = attempt Integer.parseInt(s) else e -> "bad " + s

fn show(s: String) -> String {
    val r = parse(s)
    if (r is Err) {
        return "error " + r.error()
    } else {
        return "value " + (r.value() + 1)
    }
}

fn label(s: String) -> String {
    val r = parse(s)
    if (r is Ok) {
        return "ok " + r.value()
    } else {
        return r.error().toUpperCase()
    }
}

fn main() {
    println(show("1"))
    println(show("x"))
    println(label("2"))
    println(label("y"))
}
