package app
import java.util.List

fn main() {
    val numbers: List<Int> = List.of(5, -1, 3, 8, 3, 0)
    println(numbers |> filter { it > 0 } |> map { it * 2 })
    println(numbers |> distinct |> sorted |> limit(3))
    println(numbers |> sorted { a, b -> b.compareTo(a) } |> skip(4))
    println(numbers |> filter { n -> n > 4 } |> count)
    println(numbers |> anyMatch { it < 0 })
    println(numbers |> filter { it > 100 } |> first)
    numbers |> filter { it == 3 } |> forEach { println("three") }
}
