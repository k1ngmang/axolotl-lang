package app

import java.util.ArrayList
import java.util.List

fn fromTest(o: Object) -> Int {
    if (o is List) {
        val strings: List<String> = o
        return strings.size()
    }
    return 0
}

fn kept(o: Object) -> Int = if (o is List) o.size() else 0

fn main() {
    val ints = ArrayList<Int>()
    println(fromTest(ints) + kept(ints))
}
