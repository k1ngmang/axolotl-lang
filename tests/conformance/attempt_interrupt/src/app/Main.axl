package app

import java.io.StringReader
import java.util.List
import java.util.concurrent.Executors
import java.util.concurrent.LinkedBlockingQueue
import java.util.concurrent.TimeUnit

// A caught interrupt runs the handler and leaves the thread interrupted, so that the loop ends.
class Worker : Runnable {
    fn run() {
        while (!Thread.currentThread().isInterrupted()) {
            attempt Thread.sleep(20L) else e -> print("")
        }
    }
}

fn interrupted() -> Boolean = Thread.interrupted()

fn statement() -> Boolean {
    Thread.currentThread().interrupt()
    attempt Thread.sleep(10000L) else e -> print("")
    return interrupted()
}

fn value() -> Boolean {
    Thread.currentThread().interrupt()
    val taken = attempt LinkedBlockingQueue<Int>().take() else e -> -1
    return taken is Err && interrupted()
}

fn waitLong() -> Int {
    attempt Thread.sleep(10000L) else e -> throw IllegalStateException("woken")
    return 1
}

fn rethrown() -> Boolean {
    Thread.currentThread().interrupt()
    val slept = attempt waitLong() else e -> e.getMessage()
    return slept is Err && interrupted()
}

fn take() -> Int {
    val taken = attempt LinkedBlockingQueue<Int>().take() else e -> throw IllegalStateException(e)
    return taken
}

fn thrown() -> Boolean {
    Thread.currentThread().interrupt()
    val taken = attempt take() else e -> e.getMessage()
    return taken is Err && interrupted()
}

fn exit() -> Boolean {
    var slept = 0
    for (i in List.of(1, 2)) {
        Thread.currentThread().interrupt()
        attempt Thread.sleep(10000L) else e -> continue
        slept += 1
    }
    return slept == 0 && interrupted()
}

fn resource() -> Boolean {
    Thread.currentThread().interrupt()
    use (val reader = StringReader("x")) {
        Thread.sleep(10000L)
    } else e -> print("")
    return interrupted()
}

fn main() {
    println("statement " + statement())
    println("value " + value())
    println("rethrown " + rethrown())
    println("thrown " + thrown())
    println("exit " + exit())
    println("resource " + resource())
    val pool = Executors.newSingleThreadExecutor()
    pool.execute(Worker())
    attempt Thread.sleep(50L) else e -> throw IllegalStateException(e)
    pool.shutdownNow()
    val stopped = attempt pool.awaitTermination(5L, TimeUnit.SECONDS) else e -> false
    println("worker stopped " + stopped.getOrElse(false))
}
