package app

import java.util.List

sealed interface Event {
    val id: Int
}
data class Created(val id: Int, val name: String) : Event
data class Deleted(val id: Int) : Event

// The `is` test is fine; the pipe still gives a `List<Event>`.
fn onlyCreated(events: List<Event>) -> List<Created> = events |> filter { it is Created } |> map { it }
