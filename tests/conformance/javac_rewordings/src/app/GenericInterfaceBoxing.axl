package app

// A Java interface that is not the JDK's: the translator does not know where it has a type variable.
class Counter : Feed<Int> {
    var last: Int = 0

    fn next() -> Int = last

    fn push(item: Int) {
        last = item
    }
}

fn main() {
    val counter = Counter()
    counter.push(3)
    println(counter.next())
}
