package app

// A generic Java interface of the sources of the build, not of the JDK: Int is written where it has a type variable.
class Counter : Feed<Int> {
    var last: Int = 0

    fn next() -> Int = last

    fn push(item: Int) {
        last = item
    }
}

fn main() {
    val counter = Counter()
    counter.push(3)
    println(counter.next())
}
