package app

import java.util.List
import java.util.function.BiFunction
import java.util.function.Function
import java.util.function.IntUnaryOperator

fn main() {
    val f: Function<Int, Int> = { x: Int -> x + 1 }
    val g: IntUnaryOperator = { x: Int -> x * 3 }
    val h: BiFunction<Int, String?, String> = { n: Int, s: String? -> "" + n + s }
    println(f.apply(1))
    println(g.applyAsInt(2))
    println(h.apply(3, null))
    List.of(1, 2) |> map { x: Int -> x * 2 } |> forEach { println(it) }
}
