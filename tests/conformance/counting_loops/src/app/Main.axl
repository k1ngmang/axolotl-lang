package app

import java.time.Duration
import java.time.LocalDate
import java.util.ArrayList
import java.util.List
import java.util.concurrent.atomic.AtomicInteger
import java.util.function.Supplier

val calls: AtomicInteger = AtomicInteger()

fn counted(n: Int) -> Int {
    calls.incrementAndGet()
    return n
}

// `until` leaves the end out; the end is read once, even when it is a call.
fn upTo(xs: List<String>) -> String {
    val sb = StringBuilder()
    for (i in 0 until xs.size()) {
        sb.append(i).append(xs.get(i))
    }
    for (i in 0 until counted(3)) {
        sb.append(i)
    }
    return sb.toString()
}

// The inner loop of Myers' diff: `for (int k = -d; k <= d; k += 2)`.
fn diagonals(d: Int) -> String {
    val sb = StringBuilder()
    for (k in -d..d step 2) {
        sb.append(" ").append(k)
    }
    return sb.toString()
}

fn backwards(n: Int) -> String {
    val sb = StringBuilder()
    for (i in n - 1 downTo 0 step 2) {
        sb.append(" ").append(i)
    }
    for (i in n downTo n - 2) {
        sb.append(" ").append(i)
    }
    return sb.toString()
}

// Ends at the limits of `Int` and `Long` stop there instead of starting again at the other end.
fn limits() {
    var count = 0
    for (i in Integer.MAX_VALUE - 2..Integer.MAX_VALUE) {
        count += 1
    }
    for (i in Integer.MIN_VALUE + 1 downTo Integer.MIN_VALUE) {
        count += 1
    }
    for (i in Integer.MAX_VALUE - 5 until Integer.MAX_VALUE step 2) {
        count += 1
    }
    for (i in Integer.MAX_VALUE - 6..Integer.MAX_VALUE step 3) {
        if (i == Integer.MAX_VALUE - 3) {
            continue
        }
        count += 1
    }
    for (i in 2147483645..2147483647) {
        count += 1
    }
    println("at the limits: " + count)
    val longs = StringBuilder()
    for (i in Long.MAX_VALUE - 1..Long.MAX_VALUE) {
        longs.append(" ").append(i - Long.MAX_VALUE)
    }
    for (i in 9223372036854775800L..9223372036854775807L step 4) {
        longs.append(" ").append(i - Long.MAX_VALUE)
    }
    println("long ends:" + longs)
}

// A `Long` bound makes the variable a `Long`, also past the largest `Int`.
fn longRange() {
    var sum = 0L
    for (i in 0 until 3L) {
        sum += i
    }
    val big = 3000000000L
    for (i in big..big + 2) {
        sum += i
    }
    // javac decides the type of values the file does not tell: here a `Long`, then an `Int`.
    val start = Duration.ofSeconds(4000000000L)
    for (i in start.toSeconds() until start.toSeconds() + 2) {
        sum += i
    }
    println("long sum: " + sum)
    val days = StringBuilder()
    for (day in 1..LocalDate.of(2024, 2, 3).getDayOfMonth()) {
        days.append(day)
    }
    println("days: " + days)
}

fn steps(step: Int) -> String {
    val sb = StringBuilder()
    for (i in 0..10 step step) {
        sb.append(" ").append(i)
    }
    return sb.toString()
}

fn emptyRanges() {
    var runs = 0
    for (i in 5 until 5) {
        runs += 1
    }
    for (i in 3..1) {
        runs += 1
    }
    for (i in 1 downTo 3) {
        runs += 1
    }
    val n = 0
    for (i in 1..n step 2) {
        runs += 1
    }
    println("empty ranges ran " + runs + " times")
    // `until`, `downTo` and `step` are names elsewhere.
    val until = 2
    val downTo = 1
    var sum = 0
    for (i in until downTo downTo) {
        sum += i
    }
    println("2 downTo 1 adds up to " + sum)
}

// `break` and `continue` work as in other loops, also inside a `when`.
fn jumps() -> String {
    val sb = StringBuilder()
    for (i in 1..20) {
        if (i % 2 == 0) {
            continue
        }
        when (i) {
            9 -> break
            else -> sb.append(i)
        }
    }
    var limit = 4
    // The body changes `limit`, so the loop reads it once, before the first step.
    for (i in 0 until limit) {
        limit -= 1
        sb.append("-").append(i)
    }
    return sb.toString()
}

fn nested(n: Int) -> Int {
    var pairs = 0
    for (i in 0 until n) {
        for (j in i + 1 until n) {
            pairs += 1
        }
    }
    return pairs
}

// A lambda in the body keeps the value of its own step.
fn captured() -> List<Int> {
    val suppliers = ArrayList<Supplier<Int>>()
    for (i in 1..3) {
        suppliers.add({ -> i * 10 })
    }
    return suppliers |> map { s -> s.get() }
}

fn repeated() -> String {
    val sb = StringBuilder()
    for (_ in 1..3) {
        sb.append("x")
    }
    return sb.toString()
}

fn main() {
    println(upTo(List.of("a", "b")) + ", end read " + calls.get() + " time")
    println("diagonals:" + diagonals(3))
    println("backwards:" + backwards(6))
    limits()
    longRange()
    println("steps of 4:" + steps(4))
    println(attempt steps(0) else e -> "" + e.getMessage())
    println(attempt steps(-1) else e -> "" + e.getMessage())
    emptyRanges()
    println(jumps())
    println("pairs: " + nested(4))
    println(captured())
    println(repeated())
}
