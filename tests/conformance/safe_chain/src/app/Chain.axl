package app

fn suffix() -> String {
    println("suffix evaluated")
    return "!"
}

fn shout(s: String?) -> String? = s?.trim()?.concat(suffix())

fn main() {
    println(shout(null))
    println(shout(" hi "))
    val missing: StringBuilder? = null
    missing?.setLength(0)
    val builder: StringBuilder? = StringBuilder("ab")
    builder?.setLength(1)
    println(builder)
}
