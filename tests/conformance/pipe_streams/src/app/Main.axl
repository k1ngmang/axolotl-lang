package app

import java.nio.file.Files
import java.util.ArrayList
import java.util.List
import java.util.stream.Stream

fn parse(s: String) -> Result<Int, String> = attempt Integer.parseInt(s) else e -> "bad " + s

// A stream goes into the pipe as it is.
fn total(numbers: Stream<String>) -> Result<Int, String> {
    val parsed = numbers |> mapResult { parse(it) }
    var sum = 0
    for (n in parsed) {
        sum += n
    }
    return Ok(sum)
}

// A pipe over a property or a generic factory, whose type the translator does not know, takes a stream as well.
class Bag {
    val items = ArrayList<String>()
}

fn parsedAll(bag: Bag) -> Result<List<Int>, String> {
    val numbers = bag.items.stream() |> mapResult { parse(it) }
    return Ok(numbers)
}

fn main() {
    val s = Stream.of("b", "a", "c")
    println(s |> sorted)
    println(Stream.of(3, 1, 2) |> filter { it > 1 } |> sorted)
    val words = List.of("x", "yy", "zzz")
    println(words.stream() |> map { it.length() })
    println("a\nbb\nccc".lines() |> filter { it.length() > 1 } |> count)
    val typed: Stream<String> = words.stream()
    println(typed |> first)
    println(total(Stream.of("1", "2")))
    println(total(Stream.of("1", "x")))
    val dir = attempt Files.createTempDirectory("axl") else e -> throw IllegalStateException(e)
    val file = dir.resolve("lines.txt")
    attempt Files.writeString(file, "one\ntwo\nthree") else e -> throw IllegalStateException(e)
    use (val lines = Files.lines(file)) {
        println(lines |> filter { it.startsWith("t") })
    } else e -> println(e.getMessage())
    use (val files = Files.list(dir)) {
        println(files |> map { it.getFileName().toString() })
    } else e -> println(e.getMessage())
    val bag = Bag()
    bag.items.add("apple")
    bag.items.add("fig")
    println(bag.items.stream() |> filter { it.length() > 3 } |> count)
    println(bag.items |> map { it.length() })
    println(Stream.iterate("a", { it + "a" }) |> limit(3))
    println(parsedAll(bag))
}
