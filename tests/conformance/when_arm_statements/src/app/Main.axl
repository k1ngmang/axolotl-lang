package app

import java.util.ArrayList
import java.util.List

class Counter(var count: Int)

class Spawner {
    val names = ArrayList<String>()

    fn spawn(c: Character) {
        when (c) {
            'r' -> names.add("rat")
            'o' -> names.add("orc")
            else -> return
        }
        println("spawned " + names.size())
    }
}

fn describe(n: Int) -> String {
    when (n) {
        1 -> return "one"
        2 -> return "two"
    }
    return "many"
}

// A jump, a `return` or an assignment stands after `->` without braces, as it does elsewhere.
fn main() {
    var n = 0
    for (x in List.of(1, 2, 3, 4, 5)) {
        when (x) {
            2 -> continue
            4 -> break
            else -> n += x
        }
        println("added " + x)
    }
    println(n)
    var s = ""
    val c = Counter(0)
    for (w in List.of("a", "bb", "ccc")) {
        when (w.length()) {
            1 -> s = w
            else -> s += w
        }
        when (w) {
            "bb" -> c.count += 10
            else -> c.count += 1
        }
    }
    println(s + " " + c.count)
    val spawner = Spawner()
    spawner.spawn('r')
    spawner.spawn('#')
    spawner.spawn('o')
    println(describe(1) + " " + describe(2) + " " + describe(3))
}
