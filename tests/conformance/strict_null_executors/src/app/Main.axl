package app

import java.util.concurrent.ExecutorService
import java.util.concurrent.Executors
import java.util.concurrent.ForkJoinPool
import java.util.concurrent.Future
import java.util.concurrent.ScheduledExecutorService
import java.util.concurrent.TimeUnit
import java.util.concurrent.locks.ReentrantLock

fn main() {
    val pool: ExecutorService = Executors.newFixedThreadPool(2)
    val f: Future<Int> = pool.submit({ -> 41 + 1 })
    println(f.isDone())
    pool.shutdown()
    val sched: ScheduledExecutorService = Executors.newScheduledThreadPool(1)
    val h = sched.schedule({ -> println("tick") }, 1L, TimeUnit.MILLISECONDS)
    println(h.isCancelled())
    val repeated = sched.scheduleAtFixedRate({ -> println("tock") }, 1L, 1L, TimeUnit.MILLISECONDS)
    println(repeated.isCancelled())
    sched.shutdown()
    val fork = ForkJoinPool.commonPool().submit({ -> 2 })
    println(fork.isDone())
    val lock = ReentrantLock()
    val condition = lock.newCondition()
    println(condition.toString().length() > 0)
}
