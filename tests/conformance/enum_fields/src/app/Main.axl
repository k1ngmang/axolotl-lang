package app

enum Planet(val mass: Double, val radius: Double) {
    MERCURY(3.303e23, 2.4397e6),
    EARTH(5.976e24, 6.37814e6)
}

enum Level(val code: Int, val label: String?) { LOW(1, "low"), HIGH(3, null) }

fn gravity(p: Planet) -> Double = 6.67300E-11 * p.mass / (p.radius * p.radius)

fn describe(level: Level) -> String = when (level) {
    Level.LOW -> level.code + " " + (level.label ?: "-")
    Level.HIGH -> level.code + " " + (level.label ?: "-")
}

fn main() {
    println(Math.round(gravity(Planet.EARTH) * 100) / 100.0)
    println(Planet.MERCURY.mass > Planet.EARTH.mass)
    println(describe(Level.LOW))
    println(describe(Level.HIGH))
    println(Level.valueOf("HIGH").code)
}
