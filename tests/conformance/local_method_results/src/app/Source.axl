package app

import java.io.Reader

// Commons CSV ExtendedBufferedReader: `read()` gives a character or -1, as Java's readers do.
class Source(private val text: String) : Reader() {
    private var pos = 0

    fn read() -> Int {
        if (pos >= text.length()) {
            return -1
        }
        val c: Int = text.charAt(pos)
        pos += 1
        return c
    }

    fn read(buf: CharArray, off: Int, len: Int) -> Int = -1

    fn close() {
    }
}
