package app

// Linear for javac: the chain is generated as ((a ?: b) ?: c) ?: ...
fn main() {
    val a: String? = null
    val b: String? = "b"
    println(a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: "z".trim())
    println(a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: b ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: a ?: "z".trim())
}
