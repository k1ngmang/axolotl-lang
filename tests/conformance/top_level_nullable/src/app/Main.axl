fn cached() -> List<String>? = null
fn f(x: Int) -> Int = x + 1
fn f(x: String) -> String = x + "!"

val cfg = Map.of("a", "1")
val len = cfg.get("zz")?.length()
val firstOrNull = cfg.keySet() |> first
val fromOther = util.Other.maybe()
val either = util.Other.maybe() ?: util.Other.maybe()
