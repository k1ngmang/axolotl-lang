package app

fn parse(s: String) -> Result<Int, String> = attempt Integer.parseInt(s) else "bad"

fn check(text: String?) -> Result<Int, String> {
    val f: java.util.function.Supplier<Int> = { try parse("2") }
    val n = text?.concat(try parse("3").toString())
    val r: Result<Int, String> = attempt try parse("4") else "no"
    return Ok(1)
}
