package app

class Config(val name: String) {
    val label: String = compute()
    val title: String = name + "!"

    fn compute() -> String = "cfg " + title.length()
}

class Box(val v: String) {
    val label: String = prefix + v
}

val box: Box = Box("x")
val prefix: String = "abc".trim()

class Measured(val x: String) {
    val n: Int = measure(this)
    val later: String = x + "!"
}

fn measure(m: Measured) -> Int = m.later.length()

class Referenced(val x: String) {
    val n: Int = java.util.List.of(1).stream().mapToInt(this::calc).sum()
    val later: String = x + "!"

    fn calc(i: Int) -> Int = later.length() + i
}

class Registered(val x: String) {
    val first: String = x + "?"
    val n: Int = measureLast(this)
}

fn measureLast(r: Registered) -> Int = r.first.length()
