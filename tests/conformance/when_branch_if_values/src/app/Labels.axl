package app

// The values are literals, which do nothing as statements: the `if` alone is reported.
fn label(n: Int) -> String {
    return when (n) {
        0 -> "zero"
        else -> {
            if (n < 0) {
                "negative"
            } else {
                "positive"
            }
        }
    }
}

fn main() {
    val n = 3
    val label = when (n) {
        0 -> "zero"
        else -> {
            if (n < 0) {
                "negative"
            } else {
                "positive"
            }
        }
    }
    println(label)
}
