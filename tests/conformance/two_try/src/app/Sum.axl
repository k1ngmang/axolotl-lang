package app

fn parse(s: String) -> Result<Int, String> = attempt Integer.parseInt(s) else "bad: " + s

fn check(n: Int) -> Result<Boolean, String> {
    if (n < 0) {
        return Err("negative: " + n)
    }
    return Ok(true)
}

fn sum(a: String, b: String) -> Result<Int, String> {
    val x = try parse(a)
    val y = try parse(b)
    try check(x + y)
    return Ok(x + y)
}

fn main() {
    println(sum("1", "2"))
    println(sum("1", "q"))
    println(sum("1", "-5"))
}
