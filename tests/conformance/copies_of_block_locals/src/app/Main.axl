package app

import java.util.List

fn main() {
    val s: String? = null
    List.of(1, 2) |> forEach {
        var n = it
        n += 10
        println(s ?: "n=" + n)
    }
    println(lengths())
    println(nested().get())
}

fn lengths() -> java.util.List<Int> {
    val s: String? = null
    return List.of(1, 2) |> map { x ->
        var n = x
        n += 10
        return s?.length() ?: n
    }
}

fn given() -> java.util.function.Supplier<String>? = null

fn nested() -> java.util.function.Supplier<String> {
    var n = 1
    n += 1
    val s: String? = null
    return given() ?: { ->
        val k = s ?: "v" + n
        return k
    }
}
