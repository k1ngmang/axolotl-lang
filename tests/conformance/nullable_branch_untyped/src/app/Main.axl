package app

fn next(c: Boolean, n: Int?, k: Int) -> Int? = if (c) n else k + 1

fn size(c: Boolean, n: Int?, s: String) -> Int? = if (c) n else s.length()

fn nested(c: Boolean, n: Int?) -> Int? = if (c) n else if (!c) 42 else 7

fn chosen(c: Int, n: Int?, k: Int) {
    val r = when (c) {
        1 -> n
        else -> k + 1
    }
    println(r)
}

fn nestedUntyped(c: Boolean, d: Boolean, s: String?) {
    val v = if (c) (if (d) 42 else 3) else s?.length()
    println(v)
}

fn javaBranch(k: Int, s: String?) {
    val v = if (k == 1) Math.abs(-1) else s?.length()
    println(v)
    val w = when (k) {
        1 -> "ab".length()
        else -> s?.length()
    }
    println(w)
    println((if (k == 1) (if (s == null) Math.abs(-3) else 2) else s?.length()) ?: 5)
}

fn main() {
    println(next(true, null, 1))
    println(next(false, null, 1))
    println(size(true, null, "abc"))
    println(size(false, null, "abc"))
    println(nested(true, null))
    chosen(1, null, 1)
    chosen(2, null, 1)
    nestedUntyped(false, true, null)
    nestedUntyped(true, false, null)
    javaBranch(1, null)
    javaBranch(2, null)
}
