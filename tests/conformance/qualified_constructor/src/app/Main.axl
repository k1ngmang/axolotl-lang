package app

fn main() {
    val t = java.sql.Timestamp(1000L)
    val sb = java.lang.StringBuilder("x")
    sb.append(t.getTime())
    println(sb)
    // A call may follow the constructor at once.
    println(java.sql.Timestamp(2000L).getTime())
    println(java.lang.StringBuilder("ab").reverse())
}
